/-! ## Canonical byte decoding (inverse of `canonicalEncode`, used to prove injectivity)

Note: `packages/kernel/src/canonical.ts` provides `canonicalEncode` and `hashCanonical`,
not a byte-format decoder (`codec.ts` uses JSON arrays, not canonical byte tokens).
`canonicalDecode` is provided here as the exact inverse of `canonicalEncode` on normalized values. -/

private def isAsciiDigitByte (b : UInt8) : Bool :=
  decide (0x30 ≤ b.toNat ∧ b.toNat ≤ 0x39)

private def readDigitsUntil (delim : UInt8) (acc : Nat) :
    List UInt8 → Except CanonicalErr (Nat × List UInt8)
  | [] => .error .invalidCanonicalEncoding
  | b :: bs =>
    if b == delim then .ok (acc, bs)
    else if isAsciiDigitByte b then
      readDigitsUntil delim (acc * 10 + (b.toNat - 0x30)) bs
    else .error .invalidCanonicalEncoding

private def readPosDigitsUntil (delim : UInt8) :
    List UInt8 → Except CanonicalErr (Nat × List UInt8)
  | [] => .error .invalidCanonicalEncoding
  | b :: bs =>
    if decide (0x31 ≤ b.toNat ∧ b.toNat ≤ 0x39) then
      readDigitsUntil delim (b.toNat - 0x30) bs
    else .error .invalidCanonicalEncoding

private def readNonnegUntil (delim : UInt8) :
    List UInt8 → Except CanonicalErr (Nat × List UInt8)
  | [] => .error .invalidCanonicalEncoding
  | b :: bs =>
    if b == 0x30 then
      match bs with
      | b2 :: rest => if b2 == delim then .ok (0, rest) else .error .invalidCanonicalEncoding
      | [] => .error .invalidCanonicalEncoding
    else
      readPosDigitsUntil delim (b :: bs)

private def readCanonicalIntAux :
    List UInt8 → Except CanonicalErr (Int × List UInt8)
  | [] => .error .invalidCanonicalEncoding
  | b :: rest =>
    if b == 0x2d then
      match readPosDigitsUntil 0x3b rest with
      | .ok (n, r) => .ok (-(n : Int), r)
      | .error e => .error e
    else
      match readNonnegUntil 0x3b (b :: rest) with
      | .ok (n, r) => .ok ((n : Int), r)
      | .error e => .error e

private def takeExactAux :
    Nat → List UInt8 → Except CanonicalErr (List UInt8 × List UInt8)
  | 0, bs => .ok ([], bs)
  | _ + 1, [] => .error .invalidCanonicalEncoding
  | n + 1, b :: bs =>
    match takeExactAux n bs with
    | .ok (taken, r) => .ok (b :: taken, r)
    | .error e => .error e

private def decodeStringBody (bs : List UInt8) :
    Except CanonicalErr (String × List UInt8) :=
  match readNonnegUntil 0x3a bs with
  | .error e => .error e
  | .ok (len, r1) =>
    match takeExactAux len r1 with
    | .error e => .error e
    | .ok (taken, r2) =>
      match String.fromUTF8? (ByteArray.mk taken.toArray) with
      | some s => .ok (s, r2)
      | none => .error .invalidCanonicalEncoding

mutual
  private def decodeValueAux (fuel : Nat) (bs : List UInt8) :
      Except CanonicalErr (CanonicalValue × List UInt8) :=
    match fuel with
    | 0 => .error .invalidCanonicalEncoding
    | fuel + 1 =>
      match bs with
      | [] => .error .invalidCanonicalEncoding
      | tag :: rest =>
        if tag == 0x6e then .ok (.null, rest)
        else if tag == 0x74 then .ok (.bool true, rest)
        else if tag == 0x66 then .ok (.bool false, rest)
        else if tag == 0x69 then
          match readCanonicalIntAux rest with
          | .ok (i, r) => .ok (.int i, r)
          | .error e => .error e
        else if tag == 0x73 then
          match decodeStringBody rest with
          | .ok (s, r) => .ok (.string s, r)
          | .error e => .error e
        else if tag == 0x78 then
          match readNonnegUntil 0x3a rest with
          | .ok (len, r1) =>
            match takeExactAux len r1 with
            | .ok (taken, r2) => .ok (.bytes (ByteArray.mk taken.toArray), r2)
            | .error e => .error e
          | .error e => .error e
        else if tag == 0x61 then
          match readNonnegUntil 0x3a rest with
          | .ok (count, r1) =>
            match decodeArrayAux fuel count r1 with
            | .ok (xs, r2) => .ok (.array xs, r2)
            | .error e => .error e
          | .error e => .error e
        else if tag == 0x6f then
          match readNonnegUntil 0x3a rest with
          | .ok (count, r1) =>
            match decodeEntriesAux fuel count none r1 with
            | .ok (entries, r2) => .ok (.record entries, r2)
            | .error e => .error e
          | .error e => .error e
        else .error .invalidCanonicalEncoding

  private def decodeArrayAux (fuel : Nat) (n : Nat) (bs : List UInt8) :
      Except CanonicalErr (List CanonicalValue × List UInt8) :=
    match fuel with
    | 0 => .error .invalidCanonicalEncoding
    | fuel + 1 =>
      match n with
      | 0 => .ok ([], bs)
      | n + 1 =>
        match decodeValueAux fuel bs with
        | .ok (v, r1) =>
          match decodeArrayAux fuel n r1 with
          | .ok (vs, r2) => .ok (v :: vs, r2)
          | .error e => .error e
        | .error e => .error e

  private def decodeEntriesAux (fuel : Nat) (n : Nat) (prevKey : Option ByteArray) (bs : List UInt8) :
      Except CanonicalErr (List (String × CanonicalValue) × List UInt8) :=
    match fuel with
    | 0 => .error .invalidCanonicalEncoding
    | fuel + 1 =>
      match n with
      | 0 => .ok ([], bs)
      | n + 1 =>
        match bs with
        | [] => .error .invalidCanonicalEncoding
        | tag :: rest =>
          if tag == 0x73 then
            match decodeStringBody rest with
            | .ok (k, r1) =>
              let kb := k.toUTF8
              let orderOk := match prevKey with
                | none => true
                | some pk => compareBytes pk kb == .lt
              if !orderOk then .error .invalidCanonicalEncoding
              else
                match decodeValueAux fuel r1 with
                | .ok (v, r2) =>
                  match decodeEntriesAux fuel n (some kb) r2 with
                  | .ok (restEntries, r3) => .ok ((k, v) :: restEntries, r3)
                  | .error e => .error e
                | .error e => .error e
            | .error e => .error e
          else .error .invalidCanonicalEncoding
end

/-- Inverse decoder for `canonicalEncode` (not present in `canonical.ts`).
Accepts canonical byte sequences with strictly ascending record keys and returns the normalized `CanonicalValue`. -/
def canonicalDecode (bytes : ByteArray) : Except CanonicalErr CanonicalValue :=
  match decodeValueAux (2 * bytes.size) bytes.data.toList with
  | .ok (v, []) => .ok v
  | .ok (_, _ :: _) => .error .invalidCanonicalEncoding
  | .error e => .error e

#guard canonicalDecode (canonicalEncode (.record [("beta", .int (-42)), ("alpha", .array [.null, .bool true, .bool false, .string "é😀", .bytes (ByteArray.mk #[1, 2, 3])])])) ==
       .ok (.record [("alpha", .array [.null, .bool true, .bool false, .string "é😀", .bytes (ByteArray.mk #[1, 2, 3])]), ("beta", .int (-42))])
#guard (canonicalDecode "i-0;".toUTF8).isOk == false
#guard (canonicalDecode "i00;".toUTF8).isOk == false
#guard (canonicalDecode "s01:a".toUTF8).isOk == false
#guard (canonicalDecode "o2:s1:bns1:an".toUTF8).isOk == false

/-! ## Meaning and structural invariants (`WF`, `Normalized`, `normalize`, `Equiv`) -/

mutual
  /-- Well-formedness of a `CanonicalValue`: every record has distinct keys (`Nodup`),
  matching JavaScript plain objects. -/
  def CanonicalValue.WF : CanonicalValue → Prop
    | .null => True
    | .bool _ => True
    | .string _ => True
    | .int _ => True
    | .bytes _ => True
    | .array xs => CanonicalValue.WFList xs
    | .record entries =>
      (entries.map Prod.fst).Nodup ∧ CanonicalValue.WFEntries entries

  def CanonicalValue.WFList : List CanonicalValue → Prop
    | [] => True
    | x :: xs => x.WF ∧ WFList xs

  def CanonicalValue.WFEntries : List (String × CanonicalValue) → Prop
    | [] => True
    | (_, v) :: rest => v.WF ∧ WFEntries rest
end

mutual
  /-- Strictly canonical key order: every record's keys are strictly increasing in UTF-8 byte order. -/
  def CanonicalValue.Normalized : CanonicalValue → Prop
    | .null => True
    | .bool _ => True
    | .string _ => True
    | .int _ => True
    | .bytes _ => True
    | .array xs => CanonicalValue.NormalizedList xs
    | .record entries =>
      entries.Pairwise (fun a b => compareBytes a.1.toUTF8 b.1.toUTF8 = .lt) ∧
      CanonicalValue.NormalizedEntries entries

  def CanonicalValue.NormalizedList : List CanonicalValue → Prop
    | [] => True
    | x :: xs => x.Normalized ∧ NormalizedList xs

  def CanonicalValue.NormalizedEntries : List (String × CanonicalValue) → Prop
    | [] => True
    | (_, v) :: rest => v.Normalized ∧ NormalizedEntries rest
end

mutual
  /-- Recursively normalize a `CanonicalValue` by sorting every record's entries by UTF-8 key bytes. -/
  def CanonicalValue.normalize : CanonicalValue → CanonicalValue
    | .null => .null
    | .bool b => .bool b
    | .string s => .string s
    | .int i => .int i
    | .bytes bs => .bytes bs
    | .array xs => .array (normalizeList xs)
    | .record entries => .record (sortCanonicalEntries (normalizeEntries entries))

  def CanonicalValue.normalizeList : List CanonicalValue → List CanonicalValue
    | [] => []
    | x :: xs => x.normalize :: normalizeList xs

  def CanonicalValue.normalizeEntries :
      List (String × CanonicalValue) → List (String × CanonicalValue)
    | [] => []
    | (k, v) :: rest => (k, v.normalize) :: normalizeEntries rest
end

mutual
  /-- Equivalence of canonical values up to record entry order. -/
  def CanonicalValue.Equiv : CanonicalValue → CanonicalValue → Prop
    | .null, .null => True
    | .bool a, .bool b => a = b
    | .string a, .string b => a = b
    | .int a, .int b => a = b
    | .bytes a, .bytes b => a = b
    | .array xs, .array ys => CanonicalValue.EquivList xs ys
    | .record xs, .record ys =>
      ∃ zs, xs.Perm zs ∧ CanonicalValue.EquivEntries zs ys
    | _, _ => False

  def CanonicalValue.EquivList : List CanonicalValue → List CanonicalValue → Prop
    | [], [] => True
    | x :: xs, y :: ys => x.Equiv y ∧ EquivList xs ys
    | _, _ => False

  def CanonicalValue.EquivEntries :
      List (String × CanonicalValue) → List (String × CanonicalValue) → Prop
    | [], [] => True
    | (k1, v1) :: xs, (k2, v2) :: ys => k1 = k2 ∧ v1.Equiv v2 ∧ EquivEntries xs ys
    | _, _ => False
end

/-! ## Laws: identifiers, text normalization, and ordering -/

section IdentifiersAndOrder

private lemma ccc_of_lt {cp : UInt32} (h : cp.toNat < 0x300) : UnicodeNFC.ccc cp = 0 := by
  unfold UnicodeNFC.ccc
  have hlt : cp < 0x300 := UInt32.lt_iff_toNat_lt.mpr (by simpa using h)
  simp [hlt]

private lemma nfdChar_of_lt {cp : UInt32} (h : cp.toNat < 0xC0) :
    UnicodeNFC.nfdChar cp = [cp] := by
  unfold UnicodeNFC.nfdChar
  have h1 : ¬(0xAC00 ≤ cp) := fun hle => by
    have := UInt32.le_iff_toNat_le.mp hle
    change 0xAC00 ≤ cp.toNat at this
    omega
  have h2 : cp < 0xC0 := UInt32.lt_iff_toNat_lt.mpr (by simpa using h)
  simp [h1, h2]

private lemma composePair_of_lt {a b : UInt32} (hb : b.toNat < 0x300) :
    UnicodeNFC.composePair a b = none := by
  unfold UnicodeNFC.composePair
  have h1 : ¬(0x1161 ≤ b) := fun hle => by
    have := UInt32.le_iff_toNat_le.mp hle
    change 0x1161 ≤ b.toNat at this
    omega
  have h2 : ¬(0x11A8 ≤ b) := fun hle => by
    have := UInt32.le_iff_toNat_le.mp hle
    change 0x11A8 ≤ b.toNat at this
    omega
  have h3 : b < 0x300 := UInt32.lt_iff_toNat_lt.mpr (by simpa using hb)
  simp [h1, h2, h3]

private lemma flatMap_nfdChar_ascii : ∀ (cps : List UInt32),
    (∀ cp ∈ cps, cp.toNat < 128) → cps.flatMap UnicodeNFC.nfdChar = cps
  | [], _ => rfl
  | cp :: rest, h => by
    have hcp : cp.toNat < 128 := h cp (by simp)
    have hrest : ∀ x ∈ rest, x.toNat < 128 := fun x hx => h x (by simp [hx])
    rw [List.flatMap_cons, nfdChar_of_lt (cp := cp) (by omega), flatMap_nfdChar_ascii rest hrest]
    rfl

private lemma reorderLoop_ascii : ∀ (cps acc : List UInt32),
    (∀ cp ∈ cps, cp.toNat < 128) → UnicodeNFC.reorderLoop [] acc cps = acc ++ cps
  | [], acc, _ => by simp [UnicodeNFC.reorderLoop]
  | cp :: rest, acc, h => by
    have hcp : cp.toNat < 128 := h cp (by simp)
    have hrest : ∀ x ∈ rest, x.toNat < 128 := fun x hx => h x (by simp [hx])
    have hccc : UnicodeNFC.ccc cp = 0 := ccc_of_lt (by omega)
    simp [UnicodeNFC.reorderLoop, hccc, reorderLoop_ascii rest (acc ++ [cp]) hrest]

private lemma composeLoop_ascii : ∀ (cps out : List UInt32) (starter : Option UInt32),
    (∀ cp ∈ cps, cp.toNat < 128) →
    UnicodeNFC.composeLoop out starter [] 0 cps =
      (match starter with | none => out | some s => out ++ [s]) ++ cps
  | [], out, starter, _ => by cases starter <;> simp [UnicodeNFC.composeLoop]
  | ch :: rest, out, starter, h => by
    have hch : ch.toNat < 128 := h ch (by simp)
    have hrest : ∀ x ∈ rest, x.toNat < 128 := fun x hx => h x (by simp [hx])
    have hccc : UnicodeNFC.ccc ch = 0 := ccc_of_lt (by omega)
    have hcomp : ∀ s, UnicodeNFC.composePair s ch = none := fun _ => composePair_of_lt (by omega)
    cases starter with
    | none =>
      simp [UnicodeNFC.composeLoop, hccc, composeLoop_ascii rest out (some ch) hrest]
    | some s =>
      simp [UnicodeNFC.composeLoop, hccc, hcomp s,
        composeLoop_ascii rest (out ++ [s]) (some ch) hrest]

private lemma map_u32_char_ascii : ∀ (l : List Char), (∀ c ∈ l, c.toNat < 128) →
    (l.map (fun c => UInt32.ofNat c.toNat)).map (fun cp => Char.ofNat cp.toNat) = l
  | [], _ => rfl
  | c :: cs, hl => by
    have hc : c.toNat < 128 := hl c (by simp)
    have hcs : ∀ x ∈ cs, x.toNat < 128 := fun x hx => hl x (by simp [hx])
    simp only [List.map_cons, List.cons.injEq]
    refine ⟨?_, map_u32_char_ascii cs hcs⟩
    rw [UInt32.toNat_ofNat', Nat.mod_eq_of_lt (by omega), Char.ofNat_toNat]

/-- Every pure-ASCII string is already in Unicode NFC form. -/
theorem ascii_isNFC (s : String) (h : ∀ c ∈ s.toList, c.toNat < 128) : isNFC s = true := by
  unfold isNFC toNFC UnicodeNFC.normalizeNFCList UnicodeNFC.canonicalOrder
  dsimp only
  have hcps : ∀ cp ∈ s.toList.map (fun c => UInt32.ofNat c.toNat), cp.toNat < 128 := by
    intro cp hmem
    rw [List.mem_map] at hmem
    rcases hmem with ⟨c, hc, rfl⟩
    have := h c hc
    rw [UInt32.toNat_ofNat']
    omega
  rw [flatMap_nfdChar_ascii _ hcps, reorderLoop_ascii _ [] hcps, List.nil_append]
  rw [composeLoop_ascii _ [] none hcps, List.nil_append]
  rw [map_u32_char_ascii s.toList h, String.ofList_toList]
  simp

private lemma dropLeadingJsWs_length_le : ∀ l : List Char, (dropLeadingJsWs l).length ≤ l.length
  | [] => Nat.le_refl 0
  | c :: cs => by
    unfold dropLeadingJsWs
    split_ifs
    · exact Nat.le_trans (dropLeadingJsWs_length_le cs) (Nat.le_succ _)
    · exact Nat.le_refl _

private lemma dropLeadingJsWs_eq_self_of_length : ∀ l : List Char,
    (dropLeadingJsWs l).length = l.length → dropLeadingJsWs l = l
  | [], _ => rfl
  | c :: cs, hlen => by
    unfold dropLeadingJsWs at hlen ⊢
    split_ifs at hlen with hws
    · have := dropLeadingJsWs_length_le cs
      simp only [List.length_cons] at hlen
      omega
    · simp [hws]

private lemma dropLeadingJsWs_eq_self_iff : ∀ l : List Char,
    dropLeadingJsWs l = l ↔ ∀ h : l ≠ [], isJsWhitespace (l.head h) = false
  | [] => ⟨fun _ h => absurd rfl h, fun _ => rfl⟩
  | c :: cs => by
    unfold dropLeadingJsWs
    constructor
    · intro heq _
      by_cases hws : isJsWhitespace c = true
      · simp only [hws, ↓reduceIte] at heq
        have hlen := congrArg List.length heq
        have := dropLeadingJsWs_length_le cs
        simp at hlen
        omega
      · exact Bool.eq_false_iff.mpr hws
    · intro hhead
      have hf : isJsWhitespace c = false := hhead (List.cons_ne_nil c cs)
      simp [hf]

/-- For any nonempty string, `jsTrim s = s` iff neither its first nor its last character is JS whitespace. -/
theorem jsTrim_eq_self_iff (s : String) (hne : s ≠ "") :
    jsTrim s = s ↔
      ∀ h : s.toList ≠ [],
        isJsWhitespace (s.toList.head h) = false ∧
        isJsWhitespace (s.toList.getLast h) = false := by
  have hnil : s.toList ≠ [] := fun h => hne (by rw [← String.ofList_toList (s := s), h])
  have heq_list : jsTrim s = s ↔
      dropLeadingJsWs (dropLeadingJsWs s.toList).reverse = s.toList.reverse := by
    unfold jsTrim
    nth_rw 2 [← String.ofList_toList (s := s)]
    constructor
    · intro h
      have h1 := congrArg String.toList h
      simp only [String.toList_ofList] at h1
      have h2 := congrArg List.reverse h1
      simpa [List.reverse_reverse] using h2
    · intro h
      have h1 := congrArg List.reverse h
      rw [List.reverse_reverse] at h1
      rw [h1]
  rw [heq_list]
  constructor
  · intro h _
    have hlen : (dropLeadingJsWs (dropLeadingJsWs s.toList).reverse).length = s.toList.length := by
      rw [h, List.length_reverse]
    have hle1 := dropLeadingJsWs_length_le (dropLeadingJsWs s.toList).reverse
    have hle2 := dropLeadingJsWs_length_le s.toList
    rw [List.length_reverse] at hle1
    have hdrop1_len : (dropLeadingJsWs s.toList).length = s.toList.length := by omega
    have hdrop1 : dropLeadingJsWs s.toList = s.toList :=
      dropLeadingJsWs_eq_self_of_length s.toList hdrop1_len
    have hdrop2 : dropLeadingJsWs s.toList.reverse = s.toList.reverse := by
      simpa [hdrop1] using h
    have hhead := (dropLeadingJsWs_eq_self_iff s.toList).mp hdrop1 hnil
    have hrev := (dropLeadingJsWs_eq_self_iff s.toList.reverse).mp hdrop2 (by simp [hnil])
    rw [List.head_reverse] at hrev
    exact ⟨hhead, hrev⟩
  · intro h
    obtain ⟨hhead, hlast⟩ := h hnil
    have hdrop1 : dropLeadingJsWs s.toList = s.toList :=
      (dropLeadingJsWs_eq_self_iff s.toList).mpr (fun _ => hhead)
    rw [hdrop1]
    exact (dropLeadingJsWs_eq_self_iff s.toList.reverse).mpr (fun _ => by
      simpa [List.head_reverse] using hlast)

theorem isValidIdentifier_iff (s : String) :
    isValidIdentifier s = true ↔
      s ≠ "" ∧ jsTrim s = s ∧ isNFC s = true ∧ ∀ c ∈ s.toList, isControlChar c = false := by
  have hem : ((!s.isEmpty) = true) ↔ s ≠ "" := by
    by_cases h : s.isEmpty = true
    · simp [String.isEmpty_iff.mp h]
    · have hf : s.isEmpty = false := Bool.eq_false_iff.mpr h
      simp [hf, mt String.isEmpty_iff.mpr h]
  have hctrl : ((!s.toList.any isControlChar) = true) ↔ ∀ c ∈ s.toList, isControlChar c = false := by
    by_cases h : s.toList.any isControlChar = true
    · simp only [h, Bool.not_true, Bool.false_eq_true, false_iff, not_forall]
      obtain ⟨c, hc, hct⟩ := List.any_eq_true.mp h
      exact ⟨c, hc, by simp [hct]⟩
    · have hf : s.toList.any isControlChar = false := Bool.eq_false_iff.mpr h
      simp only [hf, Bool.not_false, true_iff]
      intro c hc
      exact Bool.eq_false_iff.mpr fun hct => h (List.any_eq_true.mpr ⟨c, hc, hct⟩)
  have htrim : (jsTrim s == s) = true ↔ jsTrim s = s := beq_iff_eq
  unfold isValidIdentifier
  simp only [Bool.and_eq_true]
  exact ⟨fun ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ => ⟨hem.mp h1, htrim.mp h2, h3, hctrl.mp h4⟩,
    fun ⟨h1, h2, h3, h4⟩ => ⟨⟨⟨hem.mpr h1, htrim.mpr h2⟩, h3⟩, hctrl.mpr h4⟩⟩

/-- `identifier` accepts a string iff it satisfies all four identifier rules. -/
theorem identifier_ok_iff (Kind : String) (s : String) (id : Identifier Kind) :
    identifier Kind s = .ok id ↔ id.WF ∧ id.value = s := by
  unfold identifier
  by_cases h1 : (s.isEmpty || jsTrim s != s) = true
  · simp only [h1, ↓reduceIte, reduceCtorEq, false_iff]
    intro ⟨hwf, heq⟩
    subst heq
    simp only [Bool.or_eq_true, String.isEmpty_iff, bne_iff_ne, ne_eq] at h1
    rcases h1 with hmt | htr
    · exact hwf.nonempty hmt
    · exact htr hwf.no_boundary_whitespace
  · have h1f : (s.isEmpty || jsTrim s != s) = false := Bool.eq_false_iff.mpr h1
    simp only [h1f, Bool.false_eq_true, ↓reduceIte]
    simp only [Bool.or_eq_true, String.isEmpty_iff, bne_iff_ne, ne_eq, not_or, not_not] at h1
    by_cases h2 : (!isNFC s) = true
    · simp only [h2, ↓reduceIte, reduceCtorEq, false_iff]
      intro ⟨hwf, heq⟩
      subst heq
      simp [hwf.nfc] at h2
    · have h2f : (!isNFC s) = false := Bool.eq_false_iff.mpr h2
      simp only [h2f, Bool.false_eq_true, ↓reduceIte]
      have h2' : isNFC s = true := Bool.eq_true_of_not_eq_false (by
        intro hf; simp [hf] at h2)
      by_cases h3 : s.toList.any isControlChar = true
      · simp only [h3, ↓reduceIte, reduceCtorEq, false_iff]
        intro ⟨hwf, heq⟩
        subst heq
        rw [List.any_eq_true] at h3
        rcases h3 with ⟨c, hc, hctrl⟩
        have := hwf.no_control_chars c hc
        simp [this] at hctrl
      · have h3f : s.toList.any isControlChar = false := Bool.eq_false_iff.mpr h3
        simp only [h3f, Bool.false_eq_true, ↓reduceIte, Except.ok.injEq]
        simp only [List.any_eq_true, not_exists, not_and] at h3
        constructor
        · intro heq
          subst heq
          exact ⟨⟨h1.1, h1.2, h2', fun c hc => Bool.eq_false_iff.mpr (h3 c hc)⟩, rfl⟩
        · rintro ⟨_, heq⟩
          cases id
          exact congrArg Identifier.mk heq.symm

theorem identifier_isOk_iff (Kind : String) (s : String) :
    (∃ id, identifier Kind s = .ok id) ↔ isValidIdentifier s = true := by
  rw [isValidIdentifier_iff]
  constructor
  · rintro ⟨id, h⟩
    obtain ⟨hwf, rfl⟩ := (identifier_ok_iff Kind s id).mp h
    exact ⟨hwf.nonempty, hwf.no_boundary_whitespace, hwf.nfc, hwf.no_control_chars⟩
  · rintro ⟨h1, h2, h3, h4⟩
    exact ⟨⟨s⟩, (identifier_ok_iff Kind s ⟨s⟩).mpr ⟨⟨h1, h2, h3, h4⟩, rfl⟩⟩

theorem contentHashEquals_iff (left right : ContentHash) :
    contentHashEquals left right = true ↔ left = right := by
  cases left
  cases right
  simp [contentHashEquals, and_assoc]

theorem hashCanonical_wf (v : CanonicalValue) : (hashCanonical v).WF :=
  ⟨rfl, rfl, sha256Hex_length _, sha256Hex_isLowerHex _⟩

/-! ### Generic lexicographical list order lemmas -/

private lemma compareLex_eq_iff {α : Type} {cmp : α → α → Ordering}
    (heq : ∀ a b, cmp a b = .eq ↔ a = b) :
    ∀ xs ys : List α, List.compareLex cmp xs ys = .eq ↔ xs = ys
  | [], [] => by simp [List.compareLex_nil_nil]
  | [], _ :: _ => by simp [List.compareLex_nil_cons]
  | _ :: _, [] => by simp [List.compareLex_cons_nil]
  | x :: xs, y :: ys => by
    rw [List.compareLex_cons_cons]
    cases h : cmp x y with
    | lt => simp [Ordering.then]; exact fun hxy => by subst hxy; exact absurd ((heq x x).mpr rfl) (by simp [h])
    | gt => simp [Ordering.then]; exact fun hxy => by subst hxy; exact absurd ((heq x x).mpr rfl) (by simp [h])
    | eq =>
      have hxy := (heq x y).mp h
      subst hxy
      simp [Ordering.then, compareLex_eq_iff heq xs ys]

private lemma compareLex_lt_antisymm {α : Type} {cmp : α → α → Ordering}
    (heq : ∀ a b, cmp a b = .eq ↔ a = b)
    (hanti : ∀ a b, cmp a b = .lt ↔ cmp b a = .gt) :
    ∀ xs ys : List α, List.compareLex cmp xs ys = .lt ↔ List.compareLex cmp ys xs = .gt
  | [], [] => by simp [List.compareLex_nil_nil]
  | [], _ :: _ => by simp [List.compareLex_nil_cons, List.compareLex_cons_nil]
  | _ :: _, [] => by simp [List.compareLex_cons_nil, List.compareLex_nil_cons]
  | x :: xs, y :: ys => by
    rw [List.compareLex_cons_cons, List.compareLex_cons_cons]
    cases h : cmp x y with
    | lt =>
      have h' : cmp y x = .gt := (hanti x y).mp h
      simp [Ordering.then, h']
    | gt =>
      have h' : cmp y x = .lt := (hanti y x).mpr h
      simp [Ordering.then, h']
    | eq =>
      have hxy := (heq x y).mp h
      subst hxy
      simp [Ordering.then, h, compareLex_lt_antisymm heq hanti xs ys]

private lemma compareLex_lt_trans {α : Type} {cmp : α → α → Ordering}
    (heq : ∀ a b, cmp a b = .eq ↔ a = b)
    (htrans : ∀ a b c, cmp a b = .lt → cmp b c = .lt → cmp a c = .lt) :
    ∀ xs ys zs : List α,
      List.compareLex cmp xs ys = .lt →
      List.compareLex cmp ys zs = .lt →
      List.compareLex cmp xs zs = .lt
  | [], [], _ => by simp [List.compareLex_nil_nil]
  | [], _ :: _, [] => by simp [List.compareLex_cons_nil]
  | [], _ :: _, _ :: _ => by simp [List.compareLex_nil_cons]
  | _ :: _, [], _ => by simp [List.compareLex_cons_nil]
  | _ :: _, _ :: _, [] => by simp [List.compareLex_cons_nil]
  | x :: xs, y :: ys, z :: zs => by
    rw [List.compareLex_cons_cons, List.compareLex_cons_cons, List.compareLex_cons_cons]
    cases hxy : cmp x y <;> cases hyz : cmp y z
    · intro _ _
      simp [Ordering.then, htrans x y z hxy hyz]
    · have hyz' := (heq y z).mp hyz
      subst hyz'
      intro _ _
      simp [Ordering.then, hxy]
    · simp [Ordering.then]
    · have hxy' := (heq x y).mp hxy
      subst hxy'
      intro _ _
      simp [Ordering.then, hyz]
    · have hxy' := (heq x y).mp hxy
      have hyz' := (heq y z).mp hyz
      subst hxy'
      subst hyz'
      simp only [Ordering.then, (heq x x).mpr rfl]
      exact compareLex_lt_trans heq htrans xs ys zs
    · simp [Ordering.then]
    · simp [Ordering.then]
    · simp [Ordering.then]
    · simp [Ordering.then]

/-! ### UTF-16 text ordering (`compareCanonicalText`) -/

private lemma char_valid_cases (c : Char) :
    c.toNat < 0xD800 ∨ (0xE000 ≤ c.toNat ∧ c.toNat < 0x110000) := by
  have hv := c.valid
  exact hv

private lemma charToUTF16_prefix_inj {c1 c2 : Char} {r1 r2 : List UInt16}
    (h : charToUTF16 c1 ++ r1 = charToUTF16 c2 ++ r2) : c1 = c2 ∧ r1 = r2 := by
  have hc1 := char_valid_cases c1
  have hc2 := char_valid_cases c2
  unfold charToUTF16 at h
  by_cases h1 : c1.toNat < 0x10000 <;> by_cases h2 : c2.toNat < 0x10000
  · simp only [h1, h2, ↓reduceIte, List.cons_append, List.nil_append, List.cons.injEq] at h
    have hu : (UInt16.ofNat c1.toNat).toNat = (UInt16.ofNat c2.toNat).toNat :=
      congrArg UInt16.toNat h.1
    rw [UInt16.toNat_ofNat', UInt16.toNat_ofNat', Nat.mod_eq_of_lt (by omega),
      Nat.mod_eq_of_lt (by omega)] at hu
    exact ⟨Char.ext (UInt32.toNat_inj.mp hu), h.2⟩
  · simp only [h1, h2, ↓reduceIte, List.cons_append, List.nil_append, List.cons.injEq] at h
    have hu : (UInt16.ofNat c1.toNat).toNat =
        (UInt16.ofNat (0xD800 + ((c2.toNat - 0x10000) >>> 10))).toNat :=
      congrArg UInt16.toNat h.1
    have hshift : (c2.toNat - 0x10000) >>> 10 < 1024 := by
      rw [Nat.shiftRight_eq_div_pow]; omega
    rw [UInt16.toNat_ofNat', UInt16.toNat_ofNat', Nat.mod_eq_of_lt (by omega),
      Nat.mod_eq_of_lt (by omega)] at hu
    rcases hc1 with hlt | hge <;> omega
  · simp only [h1, h2, ↓reduceIte, List.cons_append, List.nil_append, List.cons.injEq] at h
    have hu : (UInt16.ofNat (0xD800 + ((c1.toNat - 0x10000) >>> 10))).toNat =
        (UInt16.ofNat c2.toNat).toNat :=
      congrArg UInt16.toNat h.1
    have hshift : (c1.toNat - 0x10000) >>> 10 < 1024 := by
      rw [Nat.shiftRight_eq_div_pow]; omega
    rw [UInt16.toNat_ofNat', UInt16.toNat_ofNat', Nat.mod_eq_of_lt (by omega),
      Nat.mod_eq_of_lt (by omega)] at hu
    rcases hc2 with hlt | hge <;> omega
  · simp only [h1, h2, ↓reduceIte, List.cons_append, List.nil_append, List.cons.injEq] at h
    have hu1 : (UInt16.ofNat (0xD800 + ((c1.toNat - 0x10000) >>> 10))).toNat =
        (UInt16.ofNat (0xD800 + ((c2.toNat - 0x10000) >>> 10))).toNat :=
      congrArg UInt16.toNat h.1
    have hu2 : (UInt16.ofNat (0xDC00 + ((c1.toNat - 0x10000) &&& 0x3FF))).toNat =
        (UInt16.ofNat (0xDC00 + ((c2.toNat - 0x10000) &&& 0x3FF))).toNat :=
      congrArg UInt16.toNat h.2.1
    have hs1 : (c1.toNat - 0x10000) >>> 10 < 1024 := by
      rw [Nat.shiftRight_eq_div_pow]; omega
    have hs2 : (c2.toNat - 0x10000) >>> 10 < 1024 := by
      rw [Nat.shiftRight_eq_div_pow]; omega
    have ha1 : (c1.toNat - 0x10000) &&& 0x3FF = (c1.toNat - 0x10000) % 1024 :=
      Nat.and_two_pow_sub_one_eq_mod _ 10
    have ha2 : (c2.toNat - 0x10000) &&& 0x3FF = (c2.toNat - 0x10000) % 1024 :=
      Nat.and_two_pow_sub_one_eq_mod _ 10
    have hm1 := Nat.mod_lt (c1.toNat - 0x10000) (by omega : 0 < 1024)
    have hm2 := Nat.mod_lt (c2.toNat - 0x10000) (by omega : 0 < 1024)
    rw [UInt16.toNat_ofNat', UInt16.toNat_ofNat',
      Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at hu1
    rw [UInt16.toNat_ofNat', UInt16.toNat_ofNat',
      Nat.mod_eq_of_lt (by change 56320 + (c1.toNat - 65536 &&& 1023) < 65536; rw [ha1]; omega),
      Nat.mod_eq_of_lt (by change 56320 + (c2.toNat - 65536 &&& 1023) < 65536; rw [ha2]; omega)] at hu2
    rw [Nat.shiftRight_eq_div_pow, Nat.shiftRight_eq_div_pow] at hu1
    rw [ha1, ha2] at hu2
    have hmeq : c1.toNat - 0x10000 = c2.toNat - 0x10000 := by omega
    have hceq : c1.toNat = c2.toNat := by omega
    exact ⟨Char.ext (UInt32.toNat_inj.mp hceq), h.2.2⟩

private lemma charToUTF16_ne_nil (c : Char) : charToUTF16 c ≠ [] := by
  unfold charToUTF16
  dsimp only
  split_ifs <;> simp

private lemma flatMap_charToUTF16_inj : ∀ {l1 l2 : List Char},
    l1.flatMap charToUTF16 = l2.flatMap charToUTF16 → l1 = l2
  | [], [], _ => rfl
  | [], c :: _, h => by
    simp only [List.flatMap_nil, List.flatMap_cons] at h
    exact absurd (List.append_eq_nil_iff.mp h.symm).1 (charToUTF16_ne_nil c)
  | c :: _, [], h => by
    simp only [List.flatMap_nil, List.flatMap_cons] at h
    exact absurd (List.append_eq_nil_iff.mp h).1 (charToUTF16_ne_nil c)
  | c1 :: t1, c2 :: t2, h => by
    simp only [List.flatMap_cons] at h
    obtain ⟨hc, ht⟩ := charToUTF16_prefix_inj h
    rw [hc, flatMap_charToUTF16_inj ht]

theorem stringToUTF16_inj (a b : String) : stringToUTF16 a = stringToUTF16 b ↔ a = b :=
  ⟨fun h => String.ext (flatMap_charToUTF16_inj h), fun h => congrArg stringToUTF16 h⟩

private lemma uint16_cmp_eq (a b : UInt16) : compare a b = .eq ↔ a = b := by
  change (if a < b then Ordering.lt else if a = b then Ordering.eq else Ordering.gt) = Ordering.eq ↔ a = b
  by_cases h1 : a < b
  · simp only [h1, ↓reduceIte, reduceCtorEq, false_iff]
    intro heq; subst heq; exact absurd (UInt16.lt_iff_toNat_lt.mp h1) (Nat.lt_irrefl _)
  · by_cases h2 : a = b
    · simp [h2]
    · simp [h1, h2]

private lemma uint16_cmp_anti (a b : UInt16) : compare a b = .lt ↔ compare b a = .gt := by
  change (if a < b then Ordering.lt else if a = b then Ordering.eq else Ordering.gt) = Ordering.lt ↔
    (if b < a then Ordering.lt else if b = a then Ordering.eq else Ordering.gt) = Ordering.gt
  simp only [UInt16.lt_iff_toNat_lt, ← UInt16.toNat_inj]
  by_cases h1 : a.toNat < b.toNat
  · have h2 : ¬ b.toNat < a.toNat := by omega
    have h3 : b.toNat ≠ a.toNat := by omega
    simp [h1, h2, h3]
  · by_cases h2 : b.toNat < a.toNat
    · have h3 : a.toNat ≠ b.toNat := by omega
      simp [h1, h2, h3]
    · have h3 : a.toNat = b.toNat := by omega
      simp [h3]

private lemma uint16_cmp_trans (a b c : UInt16) :
    compare a b = .lt → compare b c = .lt → compare a c = .lt := by
  change (if a < b then Ordering.lt else if a = b then Ordering.eq else Ordering.gt) = Ordering.lt →
    (if b < c then Ordering.lt else if b = c then Ordering.eq else Ordering.gt) = Ordering.lt →
    (if a < c then Ordering.lt else if a = c then Ordering.eq else Ordering.gt) = Ordering.lt
  simp only [UInt16.lt_iff_toNat_lt]
  split_ifs <;> simp_all <;> omega

theorem compareCanonicalText_eq_iff (a b : String) :
    compareCanonicalText a b = .eq ↔ a = b := by
  unfold compareCanonicalText
  change List.compareLex compare (stringToUTF16 a) (stringToUTF16 b) = .eq ↔ a = b
  rw [compareLex_eq_iff uint16_cmp_eq, stringToUTF16_inj]

theorem compareCanonicalText_antisymm (a b : String) :
    compareCanonicalText a b = .lt ↔ compareCanonicalText b a = .gt := by
  exact compareLex_lt_antisymm uint16_cmp_eq uint16_cmp_anti (stringToUTF16 a) (stringToUTF16 b)

theorem compareCanonicalText_trans (a b c : String) :
    compareCanonicalText a b = .lt →
    compareCanonicalText b c = .lt →
    compareCanonicalText a c = .lt :=
  compareLex_lt_trans uint16_cmp_eq uint16_cmp_trans
    (stringToUTF16 a) (stringToUTF16 b) (stringToUTF16 c)

/-! ### Byte array ordering (`compareBytes`) -/

private lemma uint8_cmp_eq (a b : UInt8) : compare a b = .eq ↔ a = b := by
  change (if a < b then Ordering.lt else if a = b then Ordering.eq else Ordering.gt) = Ordering.eq ↔ a = b
  by_cases h1 : a < b
  · simp only [h1, ↓reduceIte, reduceCtorEq, false_iff]
    intro heq; subst heq; exact absurd (UInt8.lt_iff_toNat_lt.mp h1) (Nat.lt_irrefl _)
  · by_cases h2 : a = b
    · simp [h2]
    · simp [h1, h2]

private lemma uint8_cmp_anti (a b : UInt8) : compare a b = .lt ↔ compare b a = .gt := by
  change (if a < b then Ordering.lt else if a = b then Ordering.eq else Ordering.gt) = Ordering.lt ↔
    (if b < a then Ordering.lt else if b = a then Ordering.eq else Ordering.gt) = Ordering.gt
  simp only [UInt8.lt_iff_toNat_lt, ← UInt8.toNat_inj]
  by_cases h1 : a.toNat < b.toNat
  · have h2 : ¬ b.toNat < a.toNat := by omega
    have h3 : b.toNat ≠ a.toNat := by omega
    simp [h1, h2, h3]
  · by_cases h2 : b.toNat < a.toNat
    · have h3 : a.toNat ≠ b.toNat := by omega
      simp [h1, h2, h3]
    · have h3 : a.toNat = b.toNat := by omega
      simp [h3]

private lemma uint8_cmp_trans (a b c : UInt8) :
    compare a b = .lt → compare b c = .lt → compare a c = .lt := by
  change (if a < b then Ordering.lt else if a = b then Ordering.eq else Ordering.gt) = Ordering.lt →
    (if b < c then Ordering.lt else if b = c then Ordering.eq else Ordering.gt) = Ordering.lt →
    (if a < c then Ordering.lt else if a = c then Ordering.eq else Ordering.gt) = Ordering.lt
  simp only [UInt8.lt_iff_toNat_lt]
  split_ifs <;> simp_all <;> omega

private lemma byteArray_data_toList_length (b : ByteArray) :
    b.data.toList.length = b.size := by
  rw [Array.length_toList]
  rfl

private lemma compareBytes_go_eq (left right : ByteArray) (i : Nat)
    (hi : i ≤ min left.size right.size) :
    compareBytes.go left right i (min left.size right.size) =
      List.compareLex compare (left.data.toList.drop i) (right.data.toList.drop i) := by
  have hk : ∃ k, k = min left.size right.size - i := ⟨_, rfl⟩
  obtain ⟨k, hk⟩ := hk
  induction k generalizing i with
  | zero =>
    have heq : i = min left.size right.size := by omega
    subst heq
    rw [compareBytes.go]
    split_ifs with hlt_irrefl
    · exact absurd hlt_irrefl (Nat.lt_irrefl _)
    have hlen1 := byteArray_data_toList_length left
    have hlen2 := byteArray_data_toList_length right
    by_cases hlt : left.size < right.size
    · have hmin : min left.size right.size = left.size := Nat.min_eq_left (Nat.le_of_lt hlt)
      rw [hmin]
      have hd1 : left.data.toList.drop left.size = [] := List.drop_of_length_le (by omega)
      have hlt2 : left.size < right.data.toList.length := by omega
      rw [hd1, ← List.getElem_cons_drop hlt2, List.compareLex_nil_cons]
      change (if left.size < right.size then Ordering.lt else if left.size = right.size then Ordering.eq else Ordering.gt) = Ordering.lt
      simp [hlt]
    · by_cases hgt : right.size < left.size
      · have hmin : min left.size right.size = right.size := Nat.min_eq_right (Nat.le_of_lt hgt)
        rw [hmin]
        have hd2 : right.data.toList.drop right.size = [] := List.drop_of_length_le (by omega)
        have hlt1 : right.size < left.data.toList.length := by omega
        rw [hd2, ← List.getElem_cons_drop hlt1, List.compareLex_cons_nil]
        change (if left.size < right.size then Ordering.lt else if left.size = right.size then Ordering.eq else Ordering.gt) = Ordering.gt
        have hne : left.size ≠ right.size := by omega
        simp [hlt, hne]
      · have hsz : left.size = right.size := by omega
        rw [hsz, Nat.min_self]
        have hd1 : left.data.toList.drop right.size = [] := List.drop_of_length_le (by omega)
        have hd2 : right.data.toList.drop right.size = [] := List.drop_of_length_le (by omega)
        rw [hd1, hd2, List.compareLex_nil_nil]
        change (if right.size < right.size then Ordering.lt else if right.size = right.size then Ordering.eq else Ordering.gt) = Ordering.eq
        simp
  | succ k ih =>
    have hlt : i < min left.size right.size := by omega
    rw [compareBytes.go, dite_eq_left_of_eq_true (eq_true hlt)]
    dsimp only
    have hlen1 := byteArray_data_toList_length left
    have hlen2 := byteArray_data_toList_length right
    have hlt1 : i < left.data.toList.length := by omega
    have hlt2 : i < right.data.toList.length := by omega
    have hl : left.get! i = left.data.toList[i] := by
      change left.data[i]! = left.data.toList[i]
      have hi1 : i < left.data.size := by change i < left.size; omega
      simp [getElem!_def, Array.getElem?_eq_getElem hi1]
    have hr : right.get! i = right.data.toList[i] := by
      change right.data[i]! = right.data.toList[i]
      have hi2 : i < right.data.size := by change i < right.size; omega
      simp [getElem!_def, Array.getElem?_eq_getElem hi2]
    rw [← List.getElem_cons_drop hlt1, ← List.getElem_cons_drop hlt2, List.compareLex_cons_cons]
    rw [hl, hr]
    change (if left.data[i] < right.data[i] then Ordering.lt
      else if right.data[i] < left.data[i] then Ordering.gt
      else compareBytes.go left right (i + 1) (min left.size right.size)) =
      (if left.data[i] < right.data[i] then Ordering.lt
        else if left.data[i] = right.data[i] then Ordering.eq
        else Ordering.gt).then
        (List.compareLex compare (left.data.toList.drop (i + 1)) (right.data.toList.drop (i + 1)))
    by_cases h1 : left.data[i] < right.data[i]
    · simp [h1]
    · by_cases h2 : right.data[i] < left.data[i]
      · have hne : left.data[i] ≠ right.data[i] := fun he => by
          rw [he] at h2; exact Nat.lt_irrefl _ (UInt8.lt_iff_toNat_lt.mp h2)
        simp [h1, h2, hne]
      · have heq : left.data[i] = right.data[i] :=
          UInt8.toNat_inj.mp (by
            have h1' : ¬ left.data[i].toNat < right.data[i].toNat :=
              fun x => h1 (UInt8.lt_iff_toNat_lt.mpr x)
            have h2' : ¬ right.data[i].toNat < left.data[i].toNat :=
              fun x => h2 (UInt8.lt_iff_toNat_lt.mpr x)
            omega)
        have hlirr : ¬ right.data[i] < right.data[i] := fun x =>
          Nat.lt_irrefl _ (UInt8.lt_iff_toNat_lt.mp x)
        simp only [heq, hlirr, ↓reduceIte, Ordering.then]
        exact ih (i + 1) (by omega) (by omega)

theorem compareBytes_eq_compareLex (left right : ByteArray) :
    compareBytes left right = List.compareLex compare left.data.toList right.data.toList := by
  simpa [compareBytes] using compareBytes_go_eq left right 0 (Nat.zero_le _)

theorem compareBytes_eq_iff (left right : ByteArray) :
    compareBytes left right = .eq ↔ left = right := by
  rw [compareBytes_eq_compareLex, compareLex_eq_iff uint8_cmp_eq]
  constructor
  · intro h; exact ByteArray.ext (Array.toList_inj.mp h)
  · intro h; subst h; rfl

theorem compareBytes_antisymm (left right : ByteArray) :
    compareBytes left right = .lt ↔ compareBytes right left = .gt := by
  rw [compareBytes_eq_compareLex, compareBytes_eq_compareLex]
  exact compareLex_lt_antisymm uint8_cmp_eq uint8_cmp_anti left.data.toList right.data.toList

theorem compareBytes_trans (a b c : ByteArray) :
    compareBytes a b = .lt → compareBytes b c = .lt → compareBytes a c = .lt := by
  rw [compareBytes_eq_compareLex, compareBytes_eq_compareLex, compareBytes_eq_compareLex]
  exact compareLex_lt_trans uint8_cmp_eq uint8_cmp_trans
    a.data.toList b.data.toList c.data.toList

theorem compareBytes_total_ne {a b : ByteArray} (h : a ≠ b) :
    compareBytes a b = .lt ∨ compareBytes a b = .gt := by
  cases hc : compareBytes a b with
  | lt => exact Or.inl rfl
  | gt => exact Or.inr rfl
  | eq => exact absurd ((compareBytes_eq_iff a b).mp hc) h

end IdentifiersAndOrder

/-! ## Laws: key-order independence (Law a) -/

section KeyOrderIndependence

private lemma eq_of_perm_of_pairwise_strict {α : Type} {R : α → α → Prop}
    (hasymm : ∀ {x y : α}, R x y → R y x → False) :
    ∀ {l1 l2 : List α}, l1.Pairwise R → l2.Pairwise R → l1.Perm l2 → l1 = l2
  | [], [], _, _, _ => rfl
  | [], _ :: _, _, _, hp => absurd hp.length_eq (by simp)
  | _ :: _, [], _, _, hp => absurd hp.length_eq (by simp)
  | a :: t1, b :: t2, p1, p2, hp => by
    by_cases hab : a = b
    · subst hab
      have ht : t1.Perm t2 := List.Perm.cons_inv hp
      rw [eq_of_perm_of_pairwise_strict hasymm p1.of_cons p2.of_cons ht]
    · have ha : a ∈ b :: t2 := hp.subset (by simp)
      have hb : b ∈ a :: t1 := hp.symm.subset (by simp)
      simp only [List.mem_cons, hab, false_or] at ha
      simp only [List.mem_cons, Ne.symm hab, false_or] at hb
      have hba : R b a := (List.pairwise_cons.mp p2).1 a ha
      have hhab : R a b := (List.pairwise_cons.mp p1).1 b hb
      exact False.elim (hasymm hhab hba)

private lemma keyCmp_trans (a b c : ByteArray × ByteArray) :
    (compareBytes a.1 b.1 != .gt) = true →
    (compareBytes b.1 c.1 != .gt) = true →
    (compareBytes a.1 c.1 != .gt) = true := by
  simp only [bne_iff_ne, ne_eq]
  intro hab hbc hca
  have h1 : compareBytes a.1 b.1 = .lt ∨ compareBytes a.1 b.1 = .eq := by
    cases h : compareBytes a.1 b.1 <;> simp_all
  have h2 : compareBytes b.1 c.1 = .lt ∨ compareBytes b.1 c.1 = .eq := by
    cases h : compareBytes b.1 c.1 <;> simp_all
  rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2
  · have := compareBytes_trans _ _ _ h1 h2
    simp [this] at hca
  · rw [(compareBytes_eq_iff _ _).mp h2] at h1
    simp [h1] at hca
  · rw [(compareBytes_eq_iff _ _).mp h1] at hca
    rw [h2] at hca
    exact absurd hca (by decide)
  · rw [(compareBytes_eq_iff _ _).mp h1, (compareBytes_eq_iff _ _).mp h2] at hca
    simp [(compareBytes_eq_iff c.1 c.1).mpr rfl] at hca

private lemma keyCmp_total (a b : ByteArray × ByteArray) :
    ((compareBytes a.1 b.1 != .gt) || (compareBytes b.1 a.1 != .gt)) = true := by
  simp only [Bool.or_eq_true, bne_iff_ne, ne_eq]
  cases h : compareBytes a.1 b.1
  · left; simp
  · left; simp
  · right
    have := (compareBytes_antisymm b.1 a.1).mpr h
    simp [this]

private lemma pairwise_strict_of_le_and_nodup :
    ∀ (l : List (ByteArray × ByteArray)),
      l.Pairwise (fun a b => (compareBytes a.1 b.1 != .gt) = true) →
      (l.map Prod.fst).Nodup →
      l.Pairwise (fun a b => compareBytes a.1 b.1 = .lt)
  | [], _, _ => List.Pairwise.nil
  | a :: rest, hp, hnodup => by
    simp only [List.map_cons, List.nodup_cons, List.mem_map] at hnodup
    rw [List.pairwise_cons] at hp ⊢
    refine ⟨?_, pairwise_strict_of_le_and_nodup rest hp.2 hnodup.2⟩
    intro b hb
    have hle := hp.1 b hb
    simp only [bne_iff_ne, ne_eq] at hle
    cases hcmp : compareBytes a.1 b.1 with
    | lt => rfl
    | gt => exact absurd hcmp hle
    | eq =>
      have keq := (compareBytes_eq_iff a.1 b.1).mp hcmp
      exact absurd ⟨b, hb, keq.symm⟩ hnodup.1

private lemma mergeSort_strict_of_nodup (entries : List (ByteArray × ByteArray))
    (hnodup : (entries.map Prod.fst).Nodup) :
    (entries.mergeSort (fun a b => compareBytes a.1 b.1 != .gt)).Pairwise
      (fun a b => compareBytes a.1 b.1 = .lt) := by
  have hp := List.pairwise_mergeSort keyCmp_trans keyCmp_total entries
  have hperm := List.mergeSort_perm entries (fun a b => compareBytes a.1 b.1 != .gt)
  have hnodup' : ((entries.mergeSort (fun a b => compareBytes a.1 b.1 != .gt)).map Prod.fst).Nodup :=
    (hperm.map Prod.fst).nodup_iff.mpr hnodup
  exact pairwise_strict_of_le_and_nodup _ hp hnodup'

private lemma mergeSort_entries_eq_of_perm {e1 e2 : List (ByteArray × ByteArray)}
    (hnodup : (e1.map Prod.fst).Nodup) (hperm : e1.Perm e2) :
    e1.mergeSort (fun a b => compareBytes a.1 b.1 != .gt) =
      e2.mergeSort (fun a b => compareBytes a.1 b.1 != .gt) := by
  have hnodup2 : (e2.map Prod.fst).Nodup := ((hperm.map Prod.fst).nodup_iff).mp hnodup
  have p1 := mergeSort_strict_of_nodup e1 hnodup
  have p2 := mergeSort_strict_of_nodup e2 hnodup2
  have s1perm := List.mergeSort_perm e1 (fun a b => compareBytes a.1 b.1 != .gt)
  have s2perm := List.mergeSort_perm e2 (fun a b => compareBytes a.1 b.1 != .gt)
  have sperm : (e1.mergeSort (fun a b => compareBytes a.1 b.1 != .gt)).Perm
      (e2.mergeSort (fun a b => compareBytes a.1 b.1 != .gt)) :=
    s1perm.trans (hperm.trans s2perm.symm)
  apply eq_of_perm_of_pairwise_strict _ p1 p2 sperm
  intro x y hxy hyx
  have := compareBytes_trans _ _ _ hxy hyx
  have hxx : compareBytes x.1 x.1 = .eq := (compareBytes_eq_iff _ _).mpr rfl
  simp [hxx] at this

private lemma encodeEntryList_fst (entries : List (String × CanonicalValue)) :
    (encodeEntryList entries).map Prod.fst = entries.map (fun p => p.1.toUTF8) := by
  induction entries with
  | nil => rfl
  | cons p rest ih =>
    rcases p with ⟨k, v⟩
    simp [encodeEntryList, ih]

private lemma nodup_toUTF8_of_nodup {ks : List String} (h : ks.Nodup) :
    (ks.map String.toUTF8).Nodup := by
  rw [List.nodup_map_iff_inj_on]
  · intro a _ b _ heq
    exact String.toByteArray_inj.mp heq
  · exact h

private lemma encodeEntryList_perm_of_perm {xs ys : List (String × CanonicalValue)}
    (hp : xs.Perm ys) : (encodeEntryList xs).Perm (encodeEntryList ys) := by
  induction hp with
  | nil => exact List.Perm.nil
  | cons x _ ih =>
    rcases x with ⟨k, v⟩
    exact List.Perm.cons _ ih
  | swap x y l =>
    rcases x with ⟨kx, vx⟩
    rcases y with ⟨ky, vy⟩
    exact List.Perm.swap _ _ _
  | trans _ _ ih1 ih2 => exact ih1.trans ih2

/-- Reordering the entries of a well-formed record does not change its encoded bytes. -/
theorem canonicalEncode_record_perm {xs ys : List (String × CanonicalValue)}
    (hnodup : (xs.map Prod.fst).Nodup) (hp : xs.Perm ys) :
    canonicalEncode (.record xs) = canonicalEncode (.record ys) := by
  simp only [canonicalEncode, encodeRecordAux]
  have hnodup' : ((encodeEntryList xs).map Prod.fst).Nodup := by
    rw [encodeEntryList_fst]
    have hmap : List.map (fun p : String × CanonicalValue => p.1.toUTF8) xs =
        List.map String.toUTF8 (List.map Prod.fst xs) := by
      simp [List.map_map]
    rw [hmap]
    exact nodup_toUTF8_of_nodup hnodup
  have heq := mergeSort_entries_eq_of_perm hnodup' (encodeEntryList_perm_of_perm hp)
  rw [heq]

mutual
  theorem CanonicalValue.Equiv_refl : ∀ (v : CanonicalValue), v.Equiv v
    | .null => trivial
    | .bool _ => rfl
    | .string _ => rfl
    | .int _ => rfl
    | .bytes _ => rfl
    | .array xs => CanonicalValue.EquivList_refl xs
    | .record xs => by
      change ∃ zs, xs.Perm zs ∧ CanonicalValue.EquivEntries zs xs
      exact ⟨xs, List.Perm.refl xs, CanonicalValue.EquivEntries_refl xs⟩

  theorem CanonicalValue.EquivList_refl : ∀ (xs : List CanonicalValue), CanonicalValue.EquivList xs xs
    | [] => trivial
    | x :: xs => ⟨x.Equiv_refl, EquivList_refl xs⟩

  theorem CanonicalValue.EquivEntries_refl :
      ∀ (xs : List (String × CanonicalValue)), CanonicalValue.EquivEntries xs xs
    | [] => trivial
    | (_, v) :: xs => ⟨rfl, v.Equiv_refl, EquivEntries_refl xs⟩
end

private lemma equivEntries_fst : ∀ {xs ys : List (String × CanonicalValue)},
    CanonicalValue.EquivEntries xs ys → xs.map Prod.fst = ys.map Prod.fst
  | [], [], _ => rfl
  | (k1, _) :: xs, (k2, _) :: ys, ⟨hk, _, rest⟩ => by
    simp [hk, equivEntries_fst rest]

private lemma wfEntries_iff_forall : ∀ {xs : List (String × CanonicalValue)},
    CanonicalValue.WFEntries xs ↔ ∀ p ∈ xs, p.2.WF
  | [] => by simp [CanonicalValue.WFEntries]
  | (_, _) :: xs => by
    simp [CanonicalValue.WFEntries, wfEntries_iff_forall]

private lemma wfEntries_of_perm {xs ys : List (String × CanonicalValue)}
    (hp : xs.Perm ys) (h : CanonicalValue.WFEntries xs) : CanonicalValue.WFEntries ys :=
  wfEntries_iff_forall.mpr fun p hmem => wfEntries_iff_forall.mp h p (hp.symm.subset hmem)

mutual
  /-- Two well-formed canonical values that differ only in record entry order encode to identical bytes. -/
  theorem canonicalEncode_eq_of_equiv : ∀ {v1 v2 : CanonicalValue},
      v1.WF → v2.WF → v1.Equiv v2 → canonicalEncode v1 = canonicalEncode v2
    | .null, .null, _, _, _ => rfl
    | .bool a, .bool b, _, _, h => by simp [CanonicalValue.Equiv] at h; subst h; rfl
    | .string a, .string b, _, _, h => by simp [CanonicalValue.Equiv] at h; subst h; rfl
    | .int a, .int b, _, _, h => by simp [CanonicalValue.Equiv] at h; subst h; rfl
    | .bytes a, .bytes b, _, _, h => by simp [CanonicalValue.Equiv] at h; subst h; rfl
    | .array xs, .array ys, h1, h2, h => by
      simp only [canonicalEncode]
      rw [encodeList_eq_of_equiv h1 h2 h]
    | .record xs, .record ys, h1, h2, h => by
      rcases h with ⟨zs, hperm, heq⟩
      have hwf_zs : CanonicalValue.WFEntries zs := wfEntries_of_perm hperm h1.2
      have hnodup_xs : ((encodeEntryList xs).map Prod.fst).Nodup := by
        rw [encodeEntryList_fst]
        have hmap : List.map (fun p : String × CanonicalValue => p.1.toUTF8) xs =
            List.map String.toUTF8 (List.map Prod.fst xs) := by
          simp [List.map_map]
        rw [hmap]
        exact nodup_toUTF8_of_nodup h1.1
      have hperm_enc : (encodeEntryList xs).Perm (encodeEntryList zs) :=
        encodeEntryList_perm_of_perm hperm
      have heq_enc : encodeEntryList zs = encodeEntryList ys :=
        encodeEntryList_eq_of_equiv hwf_zs h2.2 heq
      have hperm_final : (encodeEntryList xs).Perm (encodeEntryList ys) := by
        rw [← heq_enc]
        exact hperm_enc
      simp only [canonicalEncode, encodeRecordAux]
      rw [mergeSort_entries_eq_of_perm hnodup_xs hperm_final]

  private lemma encodeList_eq_of_equiv : ∀ {xs ys : List CanonicalValue},
      CanonicalValue.WFList xs → CanonicalValue.WFList ys →
      CanonicalValue.EquivList xs ys → encodeList xs = encodeList ys
    | [], [], _, _, _ => rfl
    | x :: xs, y :: ys, h1, h2, h => by
      simp only [encodeList, List.cons.injEq]
      exact ⟨canonicalEncode_eq_of_equiv h1.1 h2.1 h.1,
        encodeList_eq_of_equiv h1.2 h2.2 h.2⟩

  private lemma encodeEntryList_eq_of_equiv : ∀ {xs ys : List (String × CanonicalValue)},
      CanonicalValue.WFEntries xs → CanonicalValue.WFEntries ys →
      CanonicalValue.EquivEntries xs ys → encodeEntryList xs = encodeEntryList ys
    | [], [], _, _, _ => rfl
    | (k1, v1) :: xs, (k2, v2) :: ys, h1, h2, h => by
      simp only [encodeEntryList, List.cons.injEq, Prod.mk.injEq]
      exact ⟨⟨congrArg String.toUTF8 h.1, canonicalEncode_eq_of_equiv h1.1 h2.1 h.2.1⟩,
        encodeEntryList_eq_of_equiv h1.2 h2.2 h.2.2⟩
end

end KeyOrderIndependence

/-! ## Normalization, decoding inverse, injectivity, and hash collision laws (Laws b, c, d) -/

section NormalizationAndInverse

private lemma equivEntries_perm_exists_aux :
    ∀ {ys zs : List (String × CanonicalValue)}, ys.Perm zs →
    ∀ (xs : List (String × CanonicalValue)), CanonicalValue.EquivEntries xs ys →
    ∃ ws, xs.Perm ws ∧ CanonicalValue.EquivEntries ws zs := by
  intro ys zs hp
  induction hp with
  | nil =>
    intro xs heq
    cases xs with
    | nil => exact ⟨[], List.Perm.nil, trivial⟩
    | cons _ _ => simp [CanonicalValue.EquivEntries] at heq
  | @cons y l1 l2 _ ih =>
    intro xs heq
    cases xs with
    | nil => simp [CanonicalValue.EquivEntries] at heq
    | cons x xs' =>
      rcases x with ⟨kx, vx⟩
      rcases y with ⟨ky, vy⟩
      obtain ⟨hk, hv, hrest⟩ := heq
      obtain ⟨ws', hperm', heq'⟩ := ih xs' hrest
      exact ⟨(kx, vx) :: ws', hperm'.cons _, ⟨hk, hv, heq'⟩⟩
  | @swap y1 y2 l =>
    intro xs heq
    cases xs with
    | nil => simp [CanonicalValue.EquivEntries] at heq
    | cons x1 xs1 =>
      cases xs1 with
      | nil => simp [CanonicalValue.EquivEntries] at heq
      | cons x2 xs2 =>
        rcases x1 with ⟨k1, v1⟩
        rcases x2 with ⟨k2, v2⟩
        rcases y1 with ⟨ky1, vy1⟩
        rcases y2 with ⟨ky2, vy2⟩
        obtain ⟨hk1, hv1, hk2, hv2, hrest⟩ := heq
        exact ⟨(k2, v2) :: (k1, v1) :: xs2, List.Perm.swap _ _ _,
          ⟨hk2, hv2, hk1, hv1, hrest⟩⟩
  | trans _ _ ih1 ih2 =>
    intro xs heq
    obtain ⟨ws1, hp1, heq1⟩ := ih1 xs heq
    obtain ⟨ws2, hp2, heq2⟩ := ih2 ws1 heq1
    exact ⟨ws2, hp1.trans hp2, heq2⟩

private lemma equivEntries_perm_exists {xs ys zs : List (String × CanonicalValue)}
    (heq : CanonicalValue.EquivEntries xs ys) (hp : ys.Perm zs) :
    ∃ ws, xs.Perm ws ∧ CanonicalValue.EquivEntries ws zs :=
  equivEntries_perm_exists_aux hp xs heq

mutual
  theorem CanonicalValue.Equiv_symm : ∀ {v1 v2 : CanonicalValue}, v1.Equiv v2 → v2.Equiv v1
    | .null, .null, _ => trivial
    | .bool _, .bool _, h => h.symm
    | .string _, .string _, h => h.symm
    | .int _, .int _, h => h.symm
    | .bytes _, .bytes _, h => h.symm
    | .array xs, .array ys, h => CanonicalValue.EquivList_symm h
    | .record xs, .record ys, h => by
      rcases h with ⟨zs, hp, heq⟩
      have heq' := CanonicalValue.EquivEntries_symm heq
      obtain ⟨ws, hp', heq''⟩ := equivEntries_perm_exists heq' hp.symm
      exact ⟨ws, hp', heq''⟩

  theorem CanonicalValue.EquivList_symm : ∀ {xs ys : List CanonicalValue},
      CanonicalValue.EquivList xs ys → CanonicalValue.EquivList ys xs
    | [], [], _ => trivial
    | _ :: _, _ :: _, h => ⟨CanonicalValue.Equiv_symm h.1, CanonicalValue.EquivList_symm h.2⟩

  theorem CanonicalValue.EquivEntries_symm : ∀ {xs ys : List (String × CanonicalValue)},
      CanonicalValue.EquivEntries xs ys → CanonicalValue.EquivEntries ys xs
    | [], [], _ => trivial
    | (_, _) :: _, (_, _) :: _, h =>
      ⟨h.1.symm, CanonicalValue.Equiv_symm h.2.1, CanonicalValue.EquivEntries_symm h.2.2⟩
end

mutual
  theorem CanonicalValue.Equiv_trans : ∀ {v1 v2 v3 : CanonicalValue},
      v1.Equiv v2 → v2.Equiv v3 → v1.Equiv v3
    | .null, .null, .null, _, _ => trivial
    | .bool _, .bool _, .bool _, h1, h2 => h1.trans h2
    | .string _, .string _, .string _, h1, h2 => h1.trans h2
    | .int _, .int _, .int _, h1, h2 => h1.trans h2
    | .bytes _, .bytes _, .bytes _, h1, h2 => h1.trans h2
    | .array xs, .array ys, .array zs, h1, h2 => CanonicalValue.EquivList_trans h1 h2
    | .record xs, .record ys, .record zs, h1, h2 => by
      rcases h1 with ⟨z1, hp1, heq1⟩
      rcases h2 with ⟨z2, hp2, heq2⟩
      obtain ⟨z3, hp3, heq3⟩ := equivEntries_perm_exists heq1 hp2
      exact ⟨z3, hp1.trans hp3, CanonicalValue.EquivEntries_trans heq3 heq2⟩

  theorem CanonicalValue.EquivList_trans : ∀ {xs ys zs : List CanonicalValue},
      CanonicalValue.EquivList xs ys → CanonicalValue.EquivList ys zs → CanonicalValue.EquivList xs zs
    | [], [], [], _, _ => trivial
    | _ :: _, _ :: _, _ :: _, h1, h2 =>
      ⟨CanonicalValue.Equiv_trans h1.1 h2.1, CanonicalValue.EquivList_trans h1.2 h2.2⟩

  theorem CanonicalValue.EquivEntries_trans : ∀ {xs ys zs : List (String × CanonicalValue)},
      CanonicalValue.EquivEntries xs ys → CanonicalValue.EquivEntries ys zs →
      CanonicalValue.EquivEntries xs zs
    | [], [], [], _, _ => trivial
    | (_, _) :: _, (_, _) :: _, (_, _) :: _, h1, h2 =>
      ⟨h1.1.trans h2.1, CanonicalValue.Equiv_trans h1.2.1 h2.2.1,
        CanonicalValue.EquivEntries_trans h1.2.2 h2.2.2⟩
end

private lemma sortCanonicalEntries_perm (entries : List (String × CanonicalValue)) :
    (sortCanonicalEntries entries).Perm entries :=
  List.mergeSort_perm entries (fun a b => compareBytes a.1.toUTF8 b.1.toUTF8 != .gt)

mutual
  theorem CanonicalValue.Equiv_normalize : ∀ (v : CanonicalValue), v.Equiv v.normalize
    | .null => trivial
    | .bool _ => rfl
    | .string _ => rfl
    | .int _ => rfl
    | .bytes _ => rfl
    | .array xs => CanonicalValue.EquivList_normalize xs
    | .record entries => by
      simp only [CanonicalValue.normalize]
      change ∃ zs, entries.Perm zs ∧
        CanonicalValue.EquivEntries zs (sortCanonicalEntries (CanonicalValue.normalizeEntries entries))
      have heq := CanonicalValue.EquivEntries_normalize entries
      have hp := (sortCanonicalEntries_perm (CanonicalValue.normalizeEntries entries)).symm
      exact equivEntries_perm_exists heq hp

  theorem CanonicalValue.EquivList_normalize : ∀ (xs : List CanonicalValue),
      CanonicalValue.EquivList xs (CanonicalValue.normalizeList xs)
    | [] => trivial
    | x :: xs => ⟨CanonicalValue.Equiv_normalize x, CanonicalValue.EquivList_normalize xs⟩

  theorem CanonicalValue.EquivEntries_normalize : ∀ (entries : List (String × CanonicalValue)),
      CanonicalValue.EquivEntries entries (CanonicalValue.normalizeEntries entries)
    | [] => trivial
    | (_, v) :: rest =>
      ⟨rfl, CanonicalValue.Equiv_normalize v, CanonicalValue.EquivEntries_normalize rest⟩
end

private lemma normalizeEntries_fst (entries : List (String × CanonicalValue)) :
    (CanonicalValue.normalizeEntries entries).map Prod.fst = entries.map Prod.fst := by
  induction entries with
  | nil => rfl
  | cons p rest ih =>
    rcases p with ⟨k, v⟩
    simp [CanonicalValue.normalizeEntries, ih]

private lemma keyCmp_string_trans (a b c : String × CanonicalValue) :
    (compareBytes a.1.toUTF8 b.1.toUTF8 != .gt) = true →
    (compareBytes b.1.toUTF8 c.1.toUTF8 != .gt) = true →
    (compareBytes a.1.toUTF8 c.1.toUTF8 != .gt) = true :=
  keyCmp_trans (a.1.toUTF8, ByteArray.empty) (b.1.toUTF8, ByteArray.empty) (c.1.toUTF8, ByteArray.empty)

private lemma keyCmp_string_total (a b : String × CanonicalValue) :
    ((compareBytes a.1.toUTF8 b.1.toUTF8 != .gt) || (compareBytes b.1.toUTF8 a.1.toUTF8 != .gt)) = true :=
  keyCmp_total (a.1.toUTF8, ByteArray.empty) (b.1.toUTF8, ByteArray.empty)

private lemma sortCanonicalEntries_pairwise_strict (entries : List (String × CanonicalValue))
    (hnodup : (entries.map Prod.fst).Nodup) :
    (sortCanonicalEntries entries).Pairwise (fun a b => compareBytes a.1.toUTF8 b.1.toUTF8 = .lt) := by
  have hp : (sortCanonicalEntries entries).Pairwise (fun a b => compareBytes a.1.toUTF8 b.1.toUTF8 != .gt) :=
    List.pairwise_mergeSort keyCmp_string_trans keyCmp_string_total entries
  have hperm := sortCanonicalEntries_perm entries
  have hnodup' : ((sortCanonicalEntries entries).map Prod.fst).Nodup :=
    (hperm.map Prod.fst).nodup_iff.mpr hnodup
  clear hperm hnodup
  generalize hs : sortCanonicalEntries entries = l at hp hnodup'
  clear hs
  induction l with
  | nil => exact List.Pairwise.nil
  | cons a rest ih =>
    simp only [List.map_cons, List.nodup_cons, List.mem_map] at hnodup'
    rw [List.pairwise_cons] at hp ⊢
    refine ⟨?_, ih hp.2 hnodup'.2⟩
    intro b hb
    have hle := hp.1 b hb
    simp only [bne_iff_ne, ne_eq] at hle
    cases hcmp : compareBytes a.1.toUTF8 b.1.toUTF8 with
    | lt => rfl
    | gt => exact absurd hcmp hle
    | eq =>
      have keq := String.toByteArray_inj.mp ((compareBytes_eq_iff a.1.toUTF8 b.1.toUTF8).mp hcmp)
      exact absurd ⟨b, hb, keq.symm⟩ hnodup'.1

private lemma normalizedEntries_iff_forall : ∀ {xs : List (String × CanonicalValue)},
    CanonicalValue.NormalizedEntries xs ↔ ∀ p ∈ xs, p.2.Normalized
  | [] => by simp [CanonicalValue.NormalizedEntries]
  | (_, _) :: xs => by
    simp [CanonicalValue.NormalizedEntries, normalizedEntries_iff_forall]

private lemma normalizedEntries_of_perm {xs ys : List (String × CanonicalValue)}
    (hp : xs.Perm ys) (h : CanonicalValue.NormalizedEntries xs) :
    CanonicalValue.NormalizedEntries ys :=
  normalizedEntries_iff_forall.mpr fun p hmem =>
    normalizedEntries_iff_forall.mp h p (hp.symm.subset hmem)

private lemma pairwise_strict_nodup_fst :
    ∀ {xs : List (String × CanonicalValue)},
      xs.Pairwise (fun a b => compareBytes a.1.toUTF8 b.1.toUTF8 = .lt) →
      (xs.map Prod.fst).Nodup
  | [], _ => List.nodup_nil
  | a :: rest, hp => by
    rw [List.pairwise_cons] at hp
    rw [List.map_cons, List.nodup_cons, List.mem_map]
    refine ⟨?_, pairwise_strict_nodup_fst hp.2⟩
    rintro ⟨b, hb, heq⟩
    have hlt := hp.1 b hb
    rw [heq, (compareBytes_eq_iff _ _).mpr rfl] at hlt
    cases hlt

mutual
  theorem CanonicalValue.Normalized_wf : ∀ {v : CanonicalValue}, v.Normalized → v.WF
    | .null, _ => trivial
    | .bool _, _ => trivial
    | .string _, _ => trivial
    | .int _, _ => trivial
    | .bytes _, _ => trivial
    | .array _, h => CanonicalValue.NormalizedList_wf h
    | .record _, h => ⟨pairwise_strict_nodup_fst h.1, CanonicalValue.NormalizedEntries_wf h.2⟩

  theorem CanonicalValue.NormalizedList_wf : ∀ {xs : List CanonicalValue},
      CanonicalValue.NormalizedList xs → CanonicalValue.WFList xs
    | [], _ => trivial
    | _ :: _, h => ⟨CanonicalValue.Normalized_wf h.1, CanonicalValue.NormalizedList_wf h.2⟩

  theorem CanonicalValue.NormalizedEntries_wf : ∀ {xs : List (String × CanonicalValue)},
      CanonicalValue.NormalizedEntries xs → CanonicalValue.WFEntries xs
    | [], _ => trivial
    | (_, _) :: _, h => ⟨CanonicalValue.Normalized_wf h.1, CanonicalValue.NormalizedEntries_wf h.2⟩
end

mutual
  theorem CanonicalValue.normalize_normalized : ∀ {v : CanonicalValue}, v.WF → v.normalize.Normalized
    | .null, _ => trivial
    | .bool _, _ => trivial
    | .string _, _ => trivial
    | .int _, _ => trivial
    | .bytes _, _ => trivial
    | .array xs, h => CanonicalValue.normalizeList_normalized h
    | .record entries, h => by
      simp only [CanonicalValue.normalize, CanonicalValue.Normalized]
      have hnodup : ((CanonicalValue.normalizeEntries entries).map Prod.fst).Nodup := by
        rw [normalizeEntries_fst]
        exact h.1
      refine ⟨sortCanonicalEntries_pairwise_strict _ hnodup, ?_⟩
      exact normalizedEntries_of_perm (sortCanonicalEntries_perm _).symm
        (CanonicalValue.normalizeEntries_normalized h.2)

  theorem CanonicalValue.normalizeList_normalized : ∀ {xs : List CanonicalValue},
      CanonicalValue.WFList xs → CanonicalValue.NormalizedList (CanonicalValue.normalizeList xs)
    | [], _ => trivial
    | _ :: _, h =>
      ⟨CanonicalValue.normalize_normalized h.1, CanonicalValue.normalizeList_normalized h.2⟩

  theorem CanonicalValue.normalizeEntries_normalized : ∀ {xs : List (String × CanonicalValue)},
      CanonicalValue.WFEntries xs → CanonicalValue.NormalizedEntries (CanonicalValue.normalizeEntries xs)
    | [], _ => trivial
    | (_, _) :: _, h =>
      ⟨CanonicalValue.normalize_normalized h.1, CanonicalValue.normalizeEntries_normalized h.2⟩
end

theorem CanonicalValue.normalize_wf {v : CanonicalValue} (h : v.WF) : v.normalize.WF :=
  CanonicalValue.Normalized_wf (CanonicalValue.normalize_normalized h)

/-- Normalizing a well-formed canonical value does not change its encoded bytes. -/
theorem canonicalEncode_normalize {v : CanonicalValue} (h : v.WF) :
    canonicalEncode v.normalize = canonicalEncode v :=
  canonicalEncode_eq_of_equiv (CanonicalValue.normalize_wf h) h
    (CanonicalValue.Equiv_symm (CanonicalValue.Equiv_normalize v))

private lemma sortCanonicalEntries_eq_self_of_pairwise :
    ∀ {entries : List (String × CanonicalValue)},
      entries.Pairwise (fun a b => compareBytes a.1.toUTF8 b.1.toUTF8 = .lt) →
      sortCanonicalEntries entries = entries := by
  intro entries hp
  have hnodup := pairwise_strict_nodup_fst hp
  have hp2 := sortCanonicalEntries_pairwise_strict entries hnodup
  have hperm := sortCanonicalEntries_perm entries
  apply eq_of_perm_of_pairwise_strict _ hp2 hp hperm
  intro x y hxy hyx
  have := compareBytes_trans _ _ _ hxy hyx
  rw [(compareBytes_eq_iff _ _).mpr rfl] at this
  cases this

mutual
  theorem CanonicalValue.normalize_idempotent : ∀ {v : CanonicalValue},
      v.Normalized → v.normalize = v
    | .null, _ => rfl
    | .bool _, _ => rfl
    | .string _, _ => rfl
    | .int _, _ => rfl
    | .bytes _, _ => rfl
    | .array xs, h => by
      simp only [CanonicalValue.normalize]
      rw [CanonicalValue.normalizeList_idempotent h]
    | .record entries, h => by
      simp only [CanonicalValue.normalize]
      rw [CanonicalValue.normalizeEntries_idempotent h.2]
      rw [sortCanonicalEntries_eq_self_of_pairwise h.1]

  theorem CanonicalValue.normalizeList_idempotent : ∀ {xs : List CanonicalValue},
      CanonicalValue.NormalizedList xs → CanonicalValue.normalizeList xs = xs
    | [], _ => rfl
    | _ :: _, h => by
      simp only [CanonicalValue.normalizeList, CanonicalValue.normalize_idempotent h.1,
        CanonicalValue.normalizeList_idempotent h.2]

  theorem CanonicalValue.normalizeEntries_idempotent : ∀ {xs : List (String × CanonicalValue)},
      CanonicalValue.NormalizedEntries xs → CanonicalValue.normalizeEntries xs = xs
    | [], _ => rfl
    | (_, _) :: _, h => by
      simp only [CanonicalValue.normalizeEntries, CanonicalValue.normalize_idempotent h.1,
        CanonicalValue.normalizeEntries_idempotent h.2]
end

/-! ### Encoding byte decomposition and `Nat`/`Int` canonical text lemmas -/

private lemma foldl_append_data_toList (xs : List ByteArray) (init : ByteArray) :
    (xs.foldl (· ++ ·) init).data.toList =
      init.data.toList ++ xs.flatMap (fun b => b.data.toList) := by
  induction xs generalizing init with
  | nil => simp
  | cons x rest ih =>
    simp only [List.foldl_cons, List.flatMap_cons]
    rw [ih (init ++ x), ByteArray.data_append, Array.toList_append, List.append_assoc]

private lemma toUTF8_append (s t : String) : (s ++ t).toUTF8 = s.toUTF8 ++ t.toUTF8 :=
  String.toByteArray_append

private lemma utf8Encode_ascii : ∀ (l : List Char), (∀ c ∈ l, c.toNat ≤ 127) →
    l.utf8Encode.data.toList = l.map (fun c => UInt8.ofNat c.toNat)
  | [], _ => rfl
  | c :: cs, h => by
    have hc : c.toNat ≤ 127 := h c (by simp)
    have hcs : ∀ x ∈ cs, x.toNat ≤ 127 := fun x hx => h x (by simp [hx])
    rw [List.utf8Encode_cons, ByteArray.data_append, Array.toList_append, utf8Encode_ascii cs hcs]
    have hhead : ([c].utf8Encode).data.toList = [UInt8.ofNat c.toNat] := by
      have h2 : String.utf8EncodeChar c = [UInt8.ofNat c.toNat] := by
        change (if c.val.toNat ≤ 127 then [UInt8.ofNat c.val.toNat] else _) = [UInt8.ofNat c.toNat]
        have hv : c.val.toNat ≤ 127 := hc
        simp only [hv, ↓reduceIte]
        rfl
      simp [List.utf8Encode, h2]
    rw [hhead]
    rfl

private lemma ascii_toUTF8_data_toList (s : String) (h : ∀ c ∈ s.toList, c.toNat ≤ 127) :
    s.toUTF8.data.toList = s.toList.map (fun c => UInt8.ofNat c.toNat) := by
  have hs := utf8Encode_ascii s.toList h
  change s.toByteArray.data.toList = _
  rw [← String.ofList_toList (s := s), String.toByteArray_ofList, String.toList_ofList]
  exact hs

private lemma digitChar_toNat {d : Nat} (hd : d < 10) : (Nat.digitChar d).toNat = 0x30 + d := by
  unfold Nat.digitChar
  rcases d with _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | d
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · omega

private def toDigitBytes (n : Nat) : List UInt8 :=
  (Nat.toDigits 10 n).map (fun c => UInt8.ofNat c.toNat)

private lemma toDigits10_isDigit (n : Nat) :
    ∀ c ∈ Nat.toDigits 10 n, '0'.toNat ≤ c.toNat ∧ c.toNat ≤ '9'.toNat := by
  induction n using Nat.strongRecOn with
  | ind n ih =>
    by_cases hlt : n < 10
    · rw [Nat.toDigits_of_lt_base hlt]
      intro c hc
      simp only [List.mem_singleton] at hc
      subst hc
      rw [digitChar_toNat hlt]
      have h0 : '0'.toNat = 48 := rfl
      have h9 : '9'.toNat = 57 := rfl
      omega
    · have hge : 10 ≤ n := by omega
      rw [Nat.toDigits_of_base_le (by decide) hge]
      intro c hc
      rw [List.mem_append] at hc
      rcases hc with hc1 | hc2
      · exact ih (n / 10) (Nat.div_lt_self (by omega) (by decide)) c hc1
      · simp only [List.mem_singleton] at hc2
        subst hc2
        rw [digitChar_toNat (Nat.mod_lt n (by decide))]
        have h0 : '0'.toNat = 48 := rfl
        have h9 : '9'.toNat = 57 := rfl
        have hm := Nat.mod_lt n (by decide : 0 < 10)
        omega

private lemma toString_nat_toUTF8 (n : Nat) :
    (toString n).toUTF8.data.toList = toDigitBytes n := by
  change (Nat.repr n).toUTF8.data.toList = toDigitBytes n
  unfold Nat.repr toDigitBytes
  have hdig : ∀ c ∈ (String.ofList (Nat.toDigits 10 n)).toList, c.toNat ≤ 127 := by
    intro c hc
    rw [String.toList_ofList] at hc
    have := toDigits10_isDigit n c hc
    have h9 : '9'.toNat = 57 := rfl
    omega
  rw [ascii_toUTF8_data_toList _ hdig, String.toList_ofList]

private lemma toDigitBytes_ne_nil (n : Nat) : toDigitBytes n ≠ [] := by
  unfold toDigitBytes
  simp [Nat.toDigits_ne_nil]

private lemma toDigitBytes_all_digits (n : Nat) :
    ∀ b ∈ toDigitBytes n, isAsciiDigitByte b = true := by
  intro b hb
  unfold toDigitBytes at hb
  rw [List.mem_map] at hb
  rcases hb with ⟨c, hc, rfl⟩
  have hdc := toDigits10_isDigit n c hc
  have h0 : '0'.toNat = 48 := rfl
  have h9 : '9'.toNat = 57 := rfl
  simp only [isAsciiDigitByte, decide_eq_true_eq]
  rw [UInt8.toNat_ofNat', Nat.mod_eq_of_lt (by omega)]
  omega

private lemma toDigitBytes_zero : toDigitBytes 0 = [0x30] := by
  unfold toDigitBytes
  rw [Nat.toDigits_zero]
  rfl

private lemma toDigitBytes_of_lt_10 {n : Nat} (h : n < 10) :
    toDigitBytes n = [UInt8.ofNat (0x30 + n)] := by
  unfold toDigitBytes
  rw [Nat.toDigits_of_lt_base h]
  simp only [List.map_cons, List.map_nil, digitChar_toNat h]

private lemma toDigitBytes_of_ge_10 {n : Nat} (h : 10 ≤ n) :
    toDigitBytes n = toDigitBytes (n / 10) ++ [UInt8.ofNat (0x30 + n % 10)] := by
  unfold toDigitBytes
  rw [Nat.toDigits_of_base_le (by decide) h, List.map_append]
  simp [digitChar_toNat (Nat.mod_lt n (by decide))]

private lemma toDigitBytes_head_pos {n : Nat} (hpos : 0 < n) :
    ∃ d rest, toDigitBytes n = d :: rest ∧ 0x31 ≤ d.toNat ∧ d.toNat ≤ 0x39 := by
  induction n using Nat.strongRecOn with
  | ind n ih =>
    by_cases hlt : n < 10
    · refine ⟨UInt8.ofNat (0x30 + n), [], toDigitBytes_of_lt_10 hlt, ?_, ?_⟩
      · rw [UInt8.toNat_ofNat', Nat.mod_eq_of_lt (by omega)]; omega
      · rw [UInt8.toNat_ofNat', Nat.mod_eq_of_lt (by omega)]; omega
    · have hge : 10 ≤ n := by omega
      obtain ⟨d, rest, hrec, h1, h2⟩ := ih (n / 10) (Nat.div_lt_self hpos (by decide)) (by omega)
      refine ⟨d, rest ++ [UInt8.ofNat (0x30 + n % 10)], ?_, h1, h2⟩
      rw [toDigitBytes_of_ge_10 hge, hrec, List.cons_append]

private def foldDigits (acc : Nat) (ds : List UInt8) : Nat :=
  ds.foldl (fun a b => a * 10 + (b.toNat - 0x30)) acc

private lemma foldDigits_append (acc : Nat) (ds1 ds2 : List UInt8) :
    foldDigits acc (ds1 ++ ds2) = foldDigits (foldDigits acc ds1) ds2 := by
  simp [foldDigits, List.foldl_append]

private lemma foldDigits_toDigitBytes (n : Nat) : foldDigits 0 (toDigitBytes n) = n := by
  induction n using Nat.strongRecOn with
  | ind n ih =>
    by_cases hlt : n < 10
    · rw [toDigitBytes_of_lt_10 hlt]
      simp only [foldDigits, List.foldl_cons, List.foldl_nil, Nat.zero_mul, Nat.zero_add,
        UInt8.toNat_ofNat']
      rw [Nat.mod_eq_of_lt (by omega)]
      omega
    · have hge : 10 ≤ n := by omega
      have hmod := Nat.mod_lt n (by decide : 0 < 10)
      rw [toDigitBytes_of_ge_10 hge, foldDigits_append,
        ih (n / 10) (Nat.div_lt_self (by omega) (by decide))]
      simp only [foldDigits, List.foldl_cons, List.foldl_nil, UInt8.toNat_ofNat']
      rw [Nat.mod_eq_of_lt (by omega)]
      omega

private lemma readDigitsUntil_app (delim : UInt8) (hdelim : isAsciiDigitByte delim = false) :
    ∀ (ds : List UInt8) (acc : Nat) (rest : List UInt8),
      (∀ b ∈ ds, isAsciiDigitByte b = true) →
      readDigitsUntil delim acc (ds ++ delim :: rest) = .ok (foldDigits acc ds, rest)
  | [], acc, rest, _ => by
    simp [foldDigits, readDigitsUntil]
  | b :: bs, acc, rest, hds => by
    have hb : isAsciiDigitByte b = true := hds b (by simp)
    have hne : (b == delim) = false := Bool.eq_false_iff.mpr fun h => by
      have h1 : b = delim := beq_iff_eq.mp h
      rw [h1, hdelim] at hb
      cases hb
    have hbs : ∀ x ∈ bs, isAsciiDigitByte x = true := fun x hx => hds x (List.mem_cons_of_mem b hx)
    have hrec := readDigitsUntil_app delim hdelim bs (acc * 10 + (b.toNat - 0x30)) rest hbs
    rw [List.cons_append, readDigitsUntil]
    simp only [hne, Bool.false_eq_true, ↓reduceIte, hb, hrec]
    rfl

private lemma readPosDigitsUntil_app (delim : UInt8) (hdelim : isAsciiDigitByte delim = false)
    {n : Nat} (hpos : 0 < n) (rest : List UInt8) :
    readPosDigitsUntil delim (toDigitBytes n ++ delim :: rest) = .ok (n, rest) := by
  obtain ⟨d, ds, heq, h1, h2⟩ := toDigitBytes_head_pos hpos
  have hds : ∀ b ∈ ds, isAsciiDigitByte b = true := fun b hb =>
    toDigitBytes_all_digits n b (by rw [heq]; simp [hb])
  have hrec := readDigitsUntil_app delim hdelim ds (d.toNat - 0x30) rest hds
  have hfold : foldDigits (d.toNat - 0x30) ds = n := by
    have := foldDigits_toDigitBytes n
    rw [heq] at this
    simpa [foldDigits] using this
  rw [hfold] at hrec
  rw [heq, List.cons_append]
  unfold readPosDigitsUntil
  have hd : decide (0x31 ≤ d.toNat ∧ d.toNat ≤ 0x39) = true := decide_eq_true ⟨h1, h2⟩
  simp [hd, hrec]

private lemma readNonnegUntil_app (delim : UInt8) (hdelim : isAsciiDigitByte delim = false)
    (n : Nat) (rest : List UInt8) :
    readNonnegUntil delim ((toString n).toUTF8.data.toList ++ delim :: rest) = .ok (n, rest) := by
  rw [toString_nat_toUTF8]
  rcases Nat.eq_zero_or_pos n with rfl | hpos
  · rw [toDigitBytes_zero]
    simp [readNonnegUntil]
  · obtain ⟨d, ds, heq, h1, _⟩ := toDigitBytes_head_pos hpos
    have hrec := readPosDigitsUntil_app delim hdelim hpos rest
    rw [heq, List.cons_append] at hrec ⊢
    have hne : (d == 0x30) = false := Bool.eq_false_iff.mpr fun h => by
      have hd : d = 0x30 := beq_iff_eq.mp h
      rw [hd] at h1; exact absurd h1 (by decide)
    simp only [readNonnegUntil, hne, Bool.false_eq_true, ↓reduceIte, hrec]

private lemma readCanonicalIntAux_app (i : Int) (rest : List UInt8) :
    readCanonicalIntAux ((toString i).toUTF8.data.toList ++ 0x3b :: rest) = .ok (i, rest) := by
  cases i with
  | ofNat n =>
    have hstr : toString (Int.ofNat n) = toString n := rfl
    rw [hstr]
    have eqrec := readNonnegUntil_app 0x3b (by decide) n rest
    have hhead : ∃ b bs, (toString n).toUTF8.data.toList = b :: bs ∧ b ≠ 0x2d := by
      rw [toString_nat_toUTF8]
      rcases Nat.eq_zero_or_pos n with rfl | hpos
      · exact ⟨0x30, [], toDigitBytes_zero, by decide⟩
      · obtain ⟨d, ds, heq, h1, _⟩ := toDigitBytes_head_pos hpos
        exact ⟨d, ds, heq, fun he => by rw [he] at h1; exact absurd h1 (by decide)⟩
    obtain ⟨b, bs, heqb, hne⟩ := hhead
    have hneb : (b == 0x2d) = false := Bool.eq_false_iff.mpr fun h => hne (beq_iff_eq.mp h)
    rw [heqb, List.cons_append] at eqrec ⊢
    simp only [readCanonicalIntAux, hneb, Bool.false_eq_true, ↓reduceIte, eqrec]
    rfl
  | negSucc m =>
    have hstr : toString (Int.negSucc m) = "-" ++ toString (m + 1) := rfl
    have hbytes : ("-" ++ toString (m + 1)).toUTF8.data.toList =
        0x2d :: toDigitBytes (m + 1) := by
      rw [toUTF8_append, ByteArray.data_append, Array.toList_append, toString_nat_toUTF8]
      rfl
    rw [hstr, hbytes, List.cons_append]
    have eqrec := readPosDigitsUntil_app 0x3b (by decide) (Nat.succ_pos m) rest
    simp only [readCanonicalIntAux, beq_self_eq_true, ↓reduceIte, eqrec]
    rfl

private lemma readDigitsUntil_ok_inv (delim : UInt8) (hdelim : isAsciiDigitByte delim = false) :
    ∀ (bs : List UInt8) (acc n : Nat) (r : List UInt8),
      readDigitsUntil delim acc bs = .ok (n, r) →
      ∃ ds, (∀ b ∈ ds, isAsciiDigitByte b = true) ∧ bs = ds ++ delim :: r ∧ n = foldDigits acc ds
  | [], _, _, _, h => by simp [readDigitsUntil] at h
  | b :: bs, acc, n, r, h => by
    unfold readDigitsUntil at h
    by_cases hbd : (b == delim) = true
    · simp only [hbd, ↓reduceIte, Except.ok.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      exact ⟨[], fun _ hm => (nomatch hm), by simp [beq_iff_eq.mp hbd], rfl⟩
    · have hbdf : (b == delim) = false := Bool.eq_false_iff.mpr hbd
      simp only [hbdf, Bool.false_eq_true, ↓reduceIte] at h
      by_cases hdig : isAsciiDigitByte b = true
      · simp only [hdig, ↓reduceIte] at h
        obtain ⟨ds, hds, hbeq, hn⟩ := readDigitsUntil_ok_inv delim hdelim bs _ _ r h
        exact ⟨b :: ds, fun x hx => by simp at hx; rcases hx with rfl | hx; exact hdig; exact hds x hx,
          by rw [hbeq, List.cons_append], hn⟩
      · have hdigf : isAsciiDigitByte b = false := Bool.eq_false_iff.mpr hdig
        simp [hdigf] at h

private lemma foldDigits_pos_of_head_pos :
    ∀ (ds : List UInt8) (acc : Nat), 0 < acc → 0 < foldDigits acc ds
  | [], acc, h => h
  | b :: bs, acc, h => by
    unfold foldDigits
    simp only [List.foldl_cons]
    exact foldDigits_pos_of_head_pos bs _ (by omega)

private lemma toDigitBytes_foldDigits_eq_of_head_pos :
    ∀ (ds : List UInt8), ds ≠ [] →
      (∀ b ∈ ds, isAsciiDigitByte b = true) →
      (∀ h : ds ≠ [], 0x31 ≤ (ds.head h).toNat ∧ (ds.head h).toNat ≤ 0x39) →
      toDigitBytes (foldDigits 0 ds) = ds := by
  intro ds
  induction ds using List.reverseRecOn with
  | nil => intro h; exact absurd rfl h
  | append_singleton pfx d ih =>
    intro _ hall hhead
    cases pfx with
    | nil =>
      simp only [List.nil_append] at hall hhead ⊢
      have hd := hhead (by simp)
      simp only [List.head_cons] at hd
      have hv : foldDigits 0 [d] = d.toNat - 0x30 := by simp [foldDigits]
      rw [hv, toDigitBytes_of_lt_10 (by omega)]
      simp only [List.cons.injEq, and_true]
      apply UInt8.toNat_inj.mp
      rw [UInt8.toNat_ofNat', Nat.mod_eq_of_lt (by omega)]
      omega
    | cons p ps =>
      have hpne : p :: ps ≠ [] := List.cons_ne_nil p ps
      have hall_p : ∀ b ∈ p :: ps, isAsciiDigitByte b = true := fun b hb =>
        hall b (List.mem_append_left [d] hb)
      have hhead_p : ∀ h : p :: ps ≠ [], 0x31 ≤ ((p :: ps).head h).toNat ∧ ((p :: ps).head h).toNat ≤ 0x39 := by
        intro _; simpa using hhead (by simp)
      have ih_p := ih hpne hall_p hhead_p
      have hpos_p : 0 < foldDigits 0 (p :: ps) := by
        simp only [foldDigits, List.foldl_cons, Nat.zero_mul, Nat.zero_add]
        have hp_hd := hhead_p hpne
        simp only [List.head_cons] at hp_hd
        exact foldDigits_pos_of_head_pos ps _ (by omega)
      have hd_dig : isAsciiDigitByte d = true := hall d (by simp)
      simp only [isAsciiDigitByte, decide_eq_true_eq] at hd_dig
      have htotal : foldDigits 0 ((p :: ps) ++ [d]) = foldDigits 0 (p :: ps) * 10 + (d.toNat - 0x30) := by
        rw [foldDigits_append]; simp [foldDigits]
      rw [htotal]
      have hge10 : 10 ≤ foldDigits 0 (p :: ps) * 10 + (d.toNat - 0x30) := by omega
      rw [toDigitBytes_of_ge_10 hge10]
      have hdiv : (foldDigits 0 (p :: ps) * 10 + (d.toNat - 0x30)) / 10 = foldDigits 0 (p :: ps) := by omega
      have hmod : (foldDigits 0 (p :: ps) * 10 + (d.toNat - 0x30)) % 10 = d.toNat - 0x30 := by omega
      rw [hdiv, hmod, ih_p]
      have hd_eq : UInt8.ofNat (0x30 + (d.toNat - 0x30)) = d := by
        apply UInt8.toNat_inj.mp
        rw [UInt8.toNat_ofNat', Nat.mod_eq_of_lt (by omega)]
        omega
      rw [hd_eq]

private lemma readPosDigitsUntil_ok_inv (delim : UInt8) (hdelim : isAsciiDigitByte delim = false) :
    ∀ (bs : List UInt8) (n : Nat) (r : List UInt8),
      readPosDigitsUntil delim bs = .ok (n, r) →
      0 < n ∧ bs = toDigitBytes n ++ delim :: r
  | [], _, _, h => by simp [readPosDigitsUntil] at h
  | b :: bs, n, r, h => by
    unfold readPosDigitsUntil at h
    by_cases hb : decide (0x31 ≤ b.toNat ∧ b.toNat ≤ 0x39) = true
    · simp only [hb, ↓reduceIte] at h
      obtain ⟨ds, hds, hbeq, hn⟩ := readDigitsUntil_ok_inv delim hdelim bs _ _ r h
      have hb' := of_decide_eq_true hb
      have hpos : 0 < foldDigits (b.toNat - 0x30) ds :=
        foldDigits_pos_of_head_pos ds _ (by omega)
      have hdig : isAsciiDigitByte b = true := by
        simp only [isAsciiDigitByte, decide_eq_true_eq]; omega
      have heq_fold : foldDigits (b.toNat - 0x30) ds = foldDigits 0 (b :: ds) := by
        simp [foldDigits]
      have hto : toDigitBytes (foldDigits 0 (b :: ds)) = b :: ds := by
        apply toDigitBytes_foldDigits_eq_of_head_pos (b :: ds) (List.cons_ne_nil _ _)
        · intro x hx; simp at hx; rcases hx with rfl | hx; exact hdig; exact hds x hx
        · intro _; simpa using hb'
      rw [← heq_fold, ← hn] at hto
      refine ⟨hn ▸ hpos, ?_⟩
      rw [hto, hbeq, List.cons_append]
    · have hbf := Bool.eq_false_iff.mpr hb
      simp [hbf] at h

private lemma readNonnegUntil_ok_inv (delim : UInt8) (hdelim : isAsciiDigitByte delim = false)
    (bs : List UInt8) (n : Nat) (r : List UInt8)
    (h : readNonnegUntil delim bs = .ok (n, r)) :
    bs = (toString n).toUTF8.data.toList ++ delim :: r := by
  cases bs with
  | nil => simp [readNonnegUntil] at h
  | cons b bs =>
    unfold readNonnegUntil at h
    by_cases hb0 : (b == 0x30) = true
    · simp only [hb0, ↓reduceIte] at h
      cases bs with
      | nil => simp at h
      | cons b2 rest =>
        simp only at h
        by_cases hbd : (b2 == delim) = true
        · simp only [hbd, ↓reduceIte, Except.ok.injEq, Prod.mk.injEq] at h
          obtain ⟨rfl, rfl⟩ := h
          rw [toString_nat_toUTF8, toDigitBytes_zero, beq_iff_eq.mp hb0, beq_iff_eq.mp hbd]
          rfl
        · simp [Bool.eq_false_iff.mpr hbd] at h
    · have hb0f := Bool.eq_false_iff.mpr hb0
      simp only [hb0f, Bool.false_eq_true, ↓reduceIte] at h
      obtain ⟨_, heq⟩ := readPosDigitsUntil_ok_inv delim hdelim (b :: bs) n r h
      rw [toString_nat_toUTF8, heq]

private lemma readCanonicalIntAux_ok_inv (bs : List UInt8) (i : Int) (r : List UInt8)
    (h : readCanonicalIntAux bs = .ok (i, r)) :
    bs = (toString i).toUTF8.data.toList ++ 0x3b :: r := by
  cases bs with
  | nil => simp [readCanonicalIntAux] at h
  | cons b rest =>
    unfold readCanonicalIntAux at h
    by_cases hbd : (b == 0x2d) = true
    · simp only [hbd, ↓reduceIte] at h
      cases hrec : readPosDigitsUntil 0x3b rest with
      | error e => simp [hrec] at h
      | ok p =>
        rcases p with ⟨n, r'⟩
        simp only [hrec, Except.ok.injEq, Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        obtain ⟨hpos, heq⟩ := readPosDigitsUntil_ok_inv 0x3b (by decide) rest n r' hrec
        obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hpos)
        have hstr : toString (-(Nat.succ m : Int)) = "-" ++ toString (m + 1) := by
          have heqi : -(Nat.succ m : Int) = Int.negSucc m := by omega
          rw [heqi]; rfl
        have hbytes : ("-" ++ toString (m + 1)).toUTF8.data.toList =
            0x2d :: toDigitBytes (m + 1) := by
          rw [toUTF8_append, ByteArray.data_append, Array.toList_append, toString_nat_toUTF8]
          rfl
        rw [hstr, hbytes, beq_iff_eq.mp hbd, List.cons_append, heq]
    · have hbdf := Bool.eq_false_iff.mpr hbd
      simp only [hbdf, Bool.false_eq_true, ↓reduceIte] at h
      cases hrec : readNonnegUntil 0x3b (b :: rest) with
      | error e => simp [hrec] at h
      | ok p =>
        rcases p with ⟨n, r'⟩
        simp only [hrec, Except.ok.injEq, Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        exact readNonnegUntil_ok_inv 0x3b (by decide) (b :: rest) n r' hrec

private lemma takeExactAux_app : ∀ (xs suffix : List UInt8),
    takeExactAux xs.length (xs ++ suffix) = .ok (xs, suffix)
  | [], suffix => rfl
  | x :: xs, suffix => by
    simp only [List.length_cons, List.cons_append, takeExactAux, takeExactAux_app xs suffix]

private lemma takeExactAux_ok_inv : ∀ (n : Nat) (bs taken r : List UInt8),
    takeExactAux n bs = .ok (taken, r) → bs = taken ++ r ∧ taken.length = n
  | 0, bs, taken, r, h => by
    simp only [takeExactAux, Except.ok.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h; exact ⟨rfl, rfl⟩
  | _ + 1, [], _, _, h => by simp [takeExactAux] at h
  | n + 1, b :: bs, taken, r, h => by
    unfold takeExactAux at h
    cases hrec : takeExactAux n bs with
    | error e => simp [hrec] at h
    | ok p =>
      rcases p with ⟨t', r'⟩
      simp only [hrec, Except.ok.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      obtain ⟨heq, hlen⟩ := takeExactAux_ok_inv n bs t' r' hrec
      exact ⟨by rw [heq, List.cons_append], by simp [hlen]⟩

private lemma fromUTF8_toUTF8 (s : String) : String.fromUTF8? s.toUTF8 = some s := by
  simp only [String.fromUTF8?, String.toUTF8, s.isValidUTF8, ↓reduceDIte, String.fromUTF8]

private lemma decodeStringBody_app (s : String) (suffix : List UInt8) :
    decodeStringBody ((toString s.toUTF8.size).toUTF8.data.toList ++ 0x3a :: s.toUTF8.data.toList ++ suffix) =
      .ok (s, suffix) := by
  have h1 := readNonnegUntil_app 0x3a (by decide) s.toUTF8.size (s.toUTF8.data.toList ++ suffix)
  have hlen : s.toUTF8.data.toList.length = s.toUTF8.size := byteArray_data_toList_length s.toUTF8
  have h2 := takeExactAux_app s.toUTF8.data.toList suffix
  rw [hlen] at h2
  have hba : ByteArray.mk s.toUTF8.data.toList.toArray = s.toUTF8 := by
    apply ByteArray.ext
    apply Array.toList_inj.mp
    rw [List.toList_toArray]
  rw [List.append_assoc, List.cons_append]
  simp only [decodeStringBody, h1, h2, hba, fromUTF8_toUTF8]

private lemma decodeStringBody_ok_inv {bs : List UInt8} {s : String} {r : List UInt8}
    (h : decodeStringBody bs = .ok (s, r)) :
    bs = (toString s.toUTF8.size).toUTF8.data.toList ++ 0x3a :: s.toUTF8.data.toList ++ r := by
  unfold decodeStringBody at h
  cases h1 : readNonnegUntil 0x3a bs with
  | error e => simp [h1] at h
  | ok p1 =>
    rcases p1 with ⟨len, r1⟩
    simp only [h1] at h
    cases h2 : takeExactAux len r1 with
    | error e => simp [h2] at h
    | ok p2 =>
      rcases p2 with ⟨taken, r2⟩
      simp only [h2] at h
      cases hu : String.fromUTF8? (ByteArray.mk taken.toArray) with
      | none => simp [hu] at h
      | some s' =>
        simp only [hu, Except.ok.injEq, Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        have hlen1 := readNonnegUntil_ok_inv 0x3a (by decide) bs len r1 h1
        obtain ⟨hr1eq, htlen⟩ := takeExactAux_ok_inv len r1 taken r2 h2
        simp only [String.fromUTF8?] at hu
        split_ifs at hu with hv
        simp only [Option.some.injEq] at hu
        subst hu
        have htaken : taken = (String.fromUTF8 (ByteArray.mk taken.toArray) hv).toUTF8.data.toList := by
          change taken = (ByteArray.mk taken.toArray).data.toList
          rw [List.toList_toArray]
        have hsz : (String.fromUTF8 (ByteArray.mk taken.toArray) hv).toUTF8.size = len := by
          rw [← byteArray_data_toList_length, ← htaken, htlen]
        rw [hlen1, hr1eq, hsz, ← htaken, List.append_assoc, List.cons_append]

/-! ### Encoding byte equations and `decodeValueAux` round-trip / inverse -/

private lemma canonicalEncode_null_bytes : (canonicalEncode .null).data.toList = [0x6e] := rfl
private lemma canonicalEncode_true_bytes : (canonicalEncode (.bool true)).data.toList = [0x74] := rfl
private lemma canonicalEncode_false_bytes : (canonicalEncode (.bool false)).data.toList = [0x66] := rfl

private lemma canonicalEncode_int_bytes (v : Int) :
    (canonicalEncode (.int v)).data.toList = 0x69 :: (toString v).toUTF8.data.toList ++ [0x3b] := by
  simp only [canonicalEncode, toUTF8_append, ByteArray.data_append, Array.toList_append]
  have hi : ("i".toUTF8).data.toList = [0x69] := rfl
  have hs : (";".toUTF8).data.toList = [0x3b] := rfl
  rw [hi, hs]
  simp only [List.cons_append, List.nil_append]

private lemma writeLengthBytes_bytes (n : Nat) :
    (writeLengthBytes n).data.toList = (toString n).toUTF8.data.toList ++ [0x3a] := by
  simp only [writeLengthBytes, toUTF8_append, ByteArray.data_append, Array.toList_append]
  rfl

private lemma canonicalEncode_string_bytes (s : String) :
    (canonicalEncode (.string s)).data.toList =
      0x73 :: (toString s.toUTF8.size).toUTF8.data.toList ++ 0x3a :: s.toUTF8.data.toList := by
  simp only [canonicalEncode, ByteArray.data_append, Array.toList_append, writeLengthBytes_bytes]
  have hs : ("s".toUTF8).data.toList = [0x73] := rfl
  rw [hs, List.append_assoc, List.singleton_append, List.append_assoc, List.cons_append]
  rfl

private lemma canonicalEncode_bytes_bytes (b : ByteArray) :
    (canonicalEncode (.bytes b)).data.toList =
      0x78 :: (toString b.size).toUTF8.data.toList ++ 0x3a :: b.data.toList := by
  simp only [canonicalEncode, ByteArray.data_append, Array.toList_append, writeLengthBytes_bytes]
  have hx : ("x".toUTF8).data.toList = [0x78] := rfl
  rw [hx, List.append_assoc, List.singleton_append, List.append_assoc, List.cons_append]
  rfl

private lemma encodeList_eq_map (xs : List CanonicalValue) :
    encodeList xs = xs.map canonicalEncode := by
  induction xs with
  | nil => rfl
  | cons x rest ih => simp [encodeList, ih]

private lemma encodeEntryList_eq_map (entries : List (String × CanonicalValue)) :
    encodeEntryList entries = entries.map (fun (k, v) => (k.toUTF8, canonicalEncode v)) := by
  induction entries with
  | nil => rfl
  | cons p rest ih =>
    rcases p with ⟨k, v⟩
    simp [encodeEntryList, ih]

private lemma canonicalEncode_array_bytes (xs : List CanonicalValue) :
    (canonicalEncode (.array xs)).data.toList =
      0x61 :: (toString xs.length).toUTF8.data.toList ++
        0x3a :: (xs.map canonicalEncode).flatMap (fun b => b.data.toList) := by
  simp only [canonicalEncode, encodeArrayAux, encodeList_eq_map, List.length_map,
    foldl_append_data_toList, ByteArray.data_append, Array.toList_append, writeLengthBytes_bytes]
  have ha : ("a".toUTF8).data.toList = [0x61] := rfl
  rw [ha, List.append_assoc, List.singleton_append, List.append_assoc, List.cons_append]
  rfl

private def encodeRecordFlat : List (String × CanonicalValue) → List UInt8
  | [] => []
  | (k, v) :: rest =>
    (0x73 :: (toString k.toUTF8.size).toUTF8.data.toList ++ 0x3a :: k.toUTF8.data.toList) ++
      (canonicalEncode v).data.toList ++ encodeRecordFlat rest

private lemma encodeRecordFlat_cons_length (k : String) (v : CanonicalValue)
    (rest : List (String × CanonicalValue)) :
    (encodeRecordFlat ((k, v) :: rest)).length =
      1 + (toString k.toUTF8.size).toUTF8.data.toList.length + 1 + k.toUTF8.data.toList.length +
        (canonicalEncode v).data.toList.length + (encodeRecordFlat rest).length := by
  simp [encodeRecordFlat]; omega

private lemma foldl_encodeRecordAux_bytes (sorted : List (ByteArray × ByteArray)) (init : ByteArray) :
    (sorted.foldl (fun acc (kb, vb) =>
        acc ++ "s".toUTF8 ++ writeLengthBytes kb.size ++ kb ++ vb) init).data.toList =
      init.data.toList ++ sorted.flatMap (fun (kb, vb) =>
        (0x73 :: (toString kb.size).toUTF8.data.toList ++ 0x3a :: kb.data.toList) ++ vb.data.toList) := by
  induction sorted generalizing init with
  | nil => simp
  | cons p rest ih =>
    rcases p with ⟨kb, vb⟩
    simp only [List.foldl_cons, List.flatMap_cons]
    rw [ih _]
    simp only [ByteArray.data_append, Array.toList_append, writeLengthBytes_bytes]
    have hs : ("s".toUTF8).data.toList = [0x73] := rfl
    rw [hs]
    simp only [List.append_assoc, List.cons_append, List.nil_append]

private lemma mergeSort_encoded_eq_self_of_pairwise :
    ∀ {entries : List (String × CanonicalValue)},
      entries.Pairwise (fun a b => compareBytes a.1.toUTF8 b.1.toUTF8 = .lt) →
      (encodeEntryList entries).mergeSort (fun a b => compareBytes a.1 b.1 != .gt) =
        encodeEntryList entries := by
  intro entries hp
  have hp_enc : (encodeEntryList entries).Pairwise (fun a b => compareBytes a.1 b.1 = .lt) := by
    induction entries with
    | nil => exact List.Pairwise.nil
    | cons p rest ih =>
      rcases p with ⟨k, v⟩
      rw [List.pairwise_cons] at hp
      rw [encodeEntryList, List.pairwise_cons]
      refine ⟨fun b hb => ?_, ih hp.2⟩
      rw [encodeEntryList_eq_map, List.mem_map] at hb
      rcases hb with ⟨⟨k', v'⟩, hm, rfl⟩
      exact hp.1 (k', v') hm
  have hnodup_enc : ((encodeEntryList entries).map Prod.fst).Nodup := by
    rw [encodeEntryList_fst]
    have hmap : List.map (fun p : String × CanonicalValue => p.1.toUTF8) entries =
        List.map String.toUTF8 (List.map Prod.fst entries) := by simp [List.map_map]
    rw [hmap]
    exact nodup_toUTF8_of_nodup (pairwise_strict_nodup_fst hp)
  have hperm := List.mergeSort_perm (encodeEntryList entries) (fun a b => compareBytes a.1 b.1 != .gt)
  have hp2 := List.pairwise_mergeSort keyCmp_trans keyCmp_total (encodeEntryList entries)
  have hnodup2 : (((encodeEntryList entries).mergeSort (fun a b => compareBytes a.1 b.1 != .gt)).map Prod.fst).Nodup :=
    (hperm.map Prod.fst).nodup_iff.mpr hnodup_enc
  have hp2_strict := pairwise_strict_of_le_and_nodup _ hp2 hnodup2
  apply eq_of_perm_of_pairwise_strict _ hp2_strict hp_enc hperm
  intro x y hxy hyx
  have := compareBytes_trans _ _ _ hxy hyx
  rw [(compareBytes_eq_iff _ _).mpr rfl] at this
  cases this

private lemma encodeEntryList_flatMap_eq : ∀ (entries : List (String × CanonicalValue)),
    (encodeEntryList entries).flatMap (fun (kb, vb) =>
      (0x73 :: (toString kb.size).toUTF8.data.toList ++ 0x3a :: kb.data.toList) ++ vb.data.toList) =
    encodeRecordFlat entries
  | [] => rfl
  | (k, v) :: rest => by
    simp only [encodeEntryList, List.flatMap_cons, encodeRecordFlat, encodeEntryList_flatMap_eq rest]

private lemma canonicalEncode_record_bytes_of_pairwise
    {entries : List (String × CanonicalValue)}
    (hp : entries.Pairwise (fun a b => compareBytes a.1.toUTF8 b.1.toUTF8 = .lt)) :
    (canonicalEncode (.record entries)).data.toList =
      0x6f :: (toString entries.length).toUTF8.data.toList ++ 0x3a :: encodeRecordFlat entries := by
  simp only [canonicalEncode, encodeRecordAux, mergeSort_encoded_eq_self_of_pairwise hp,
    foldl_encodeRecordAux_bytes, encodeEntryList_flatMap_eq]
  have hlen : (encodeEntryList entries).length = entries.length := by
    rw [encodeEntryList_eq_map, List.length_map]
  rw [hlen]
  simp only [ByteArray.data_append, Array.toList_append, writeLengthBytes_bytes]
  have ho : ("o".toUTF8).data.toList = [0x6f] := rfl
  rw [ho]
  simp only [List.append_assoc, List.cons_append, List.nil_append]

private lemma toString_nat_toUTF8_pos (n : Nat) : 1 ≤ (toString n).toUTF8.data.toList.length := by
  rw [toString_nat_toUTF8]
  exact Nat.pos_of_ne_zero (fun h => toDigitBytes_ne_nil n (List.eq_nil_of_length_eq_zero h))

private lemma canonicalEncode_bytes_pos (v : CanonicalValue) :
    1 ≤ (canonicalEncode v).data.toList.length := by
  cases v with
  | null => rw [canonicalEncode_null_bytes]; simp
  | bool b => cases b <;> [rw [canonicalEncode_false_bytes]; rw [canonicalEncode_true_bytes]] <;> simp
  | int i => rw [canonicalEncode_int_bytes]; simp
  | string s => rw [canonicalEncode_string_bytes]; simp
  | bytes b => rw [canonicalEncode_bytes_bytes]; simp
  | array xs => rw [canonicalEncode_array_bytes]; simp
  | record es =>
    simp only [canonicalEncode, encodeRecordAux, foldl_encodeRecordAux_bytes,
      ByteArray.data_append, Array.toList_append]
    have ho : ("o".toUTF8).data.toList = [0x6f] := rfl
    rw [ho]
    simp

private lemma decodeValueAux_tag_n (fuel : Nat) (rest : List UInt8) :
    decodeValueAux (fuel + 1) (0x6e :: rest) = .ok (.null, rest) := rfl

private lemma decodeValueAux_tag_t (fuel : Nat) (rest : List UInt8) :
    decodeValueAux (fuel + 1) (0x74 :: rest) = .ok (.bool true, rest) := rfl

private lemma decodeValueAux_tag_f (fuel : Nat) (rest : List UInt8) :
    decodeValueAux (fuel + 1) (0x66 :: rest) = .ok (.bool false, rest) := rfl

private lemma decodeValueAux_tag_i (fuel : Nat) (rest : List UInt8) :
    decodeValueAux (fuel + 1) (0x69 :: rest) =
      match readCanonicalIntAux rest with
      | .ok (i, r) => .ok (.int i, r)
      | .error e => .error e := rfl

private lemma decodeValueAux_tag_s (fuel : Nat) (rest : List UInt8) :
    decodeValueAux (fuel + 1) (0x73 :: rest) =
      match decodeStringBody rest with
      | .ok (s, r) => .ok (.string s, r)
      | .error e => .error e := rfl

private lemma decodeValueAux_tag_x (fuel : Nat) (rest : List UInt8) :
    decodeValueAux (fuel + 1) (0x78 :: rest) =
      match readNonnegUntil 0x3a rest with
      | .ok (len, r1) =>
        match takeExactAux len r1 with
        | .ok (taken, r2) => .ok (.bytes (ByteArray.mk taken.toArray), r2)
        | .error e => .error e
      | .error e => .error e := rfl

private lemma decodeValueAux_tag_a (fuel : Nat) (rest : List UInt8) :
    decodeValueAux (fuel + 1) (0x61 :: rest) =
      match readNonnegUntil 0x3a rest with
      | .ok (count, r1) =>
        match decodeArrayAux fuel count r1 with
        | .ok (xs, r2) => .ok (.array xs, r2)
        | .error e => .error e
      | .error e => .error e := rfl

private lemma decodeValueAux_tag_o (fuel : Nat) (rest : List UInt8) :
    decodeValueAux (fuel + 1) (0x6f :: rest) =
      match readNonnegUntil 0x3a rest with
      | .ok (count, r1) =>
        match decodeEntriesAux fuel count none r1 with
        | .ok (entries, r2) => .ok (.record entries, r2)
        | .error e => .error e
      | .error e => .error e := rfl

private lemma decodeEntriesAux_tag_s (fuel n : Nat) (prev : Option ByteArray) (rest : List UInt8) :
    decodeEntriesAux (fuel + 1) (n + 1) prev (0x73 :: rest) =
      match decodeStringBody rest with
      | .ok (k, r1) =>
        let kb := k.toUTF8
        let orderOk := match prev with
          | none => true
          | some pk => compareBytes pk kb == .lt
        if !orderOk then .error .invalidCanonicalEncoding
        else
          match decodeValueAux fuel r1 with
          | .ok (v, r2) =>
            match decodeEntriesAux fuel n (some kb) r2 with
            | .ok (restEntries, r3) => .ok ((k, v) :: restEntries, r3)
            | .error e => .error e
          | .error e => .error e
      | .error e => .error e := rfl

mutual
  private lemma decodeValueAux_encode_append :
      ∀ (v : CanonicalValue) (suffix : List UInt8) (fuel : Nat),
        v.Normalized →
        2 * (canonicalEncode v).data.toList.length ≤ fuel →
        decodeValueAux fuel ((canonicalEncode v).data.toList ++ suffix) = .ok (v, suffix)
    | .null, suffix, fuel, _, hfuel => by
      have hpos := canonicalEncode_bytes_pos .null
      rcases fuel with _ | fuel; · omega
      rw [canonicalEncode_null_bytes, List.cons_append, List.nil_append, decodeValueAux_tag_n]
    | .bool true, suffix, fuel, _, hfuel => by
      have hpos := canonicalEncode_bytes_pos (.bool true)
      rcases fuel with _ | fuel; · omega
      rw [canonicalEncode_true_bytes, List.cons_append, List.nil_append, decodeValueAux_tag_t]
    | .bool false, suffix, fuel, _, hfuel => by
      have hpos := canonicalEncode_bytes_pos (.bool false)
      rcases fuel with _ | fuel; · omega
      rw [canonicalEncode_false_bytes, List.cons_append, List.nil_append, decodeValueAux_tag_f]
    | .int i, suffix, fuel, _, hfuel => by
      have hpos := canonicalEncode_bytes_pos (.int i)
      rcases fuel with _ | fuel; · omega
      rw [canonicalEncode_int_bytes]
      simp only [List.cons_append, List.append_assoc, List.nil_append]
      rw [decodeValueAux_tag_i, readCanonicalIntAux_app i suffix]
    | .string s, suffix, fuel, _, hfuel => by
      have hpos := canonicalEncode_bytes_pos (.string s)
      rcases fuel with _ | fuel; · omega
      rw [canonicalEncode_string_bytes]
      simp only [List.cons_append, List.append_assoc]
      rw [decodeValueAux_tag_s]
      have hstr := decodeStringBody_app s suffix
      simp only [List.append_assoc, List.cons_append] at hstr
      rw [hstr]
    | .bytes b, suffix, fuel, _, hfuel => by
      have hpos := canonicalEncode_bytes_pos (.bytes b)
      rcases fuel with _ | fuel; · omega
      rw [canonicalEncode_bytes_bytes]
      simp only [List.cons_append, List.append_assoc]
      rw [decodeValueAux_tag_x]
      have h1 := readNonnegUntil_app 0x3a (by decide) b.size (b.data.toList ++ suffix)
      have h2 := takeExactAux_app b.data.toList suffix
      rw [byteArray_data_toList_length b] at h2
      have hba : ByteArray.mk b.data.toList.toArray = b :=
        ByteArray.ext (Array.toList_inj.mp List.toList_toArray)
      simp only [h1, h2, hba]
    | .array xs, suffix, fuel, hnorm, hfuel => by
      rw [canonicalEncode_array_bytes] at hfuel ⊢
      have hdig : 1 ≤ (toString xs.length).toUTF8.data.toList.length := toString_nat_toUTF8_pos xs.length
      simp only [List.length_append, List.length_cons] at hfuel
      rcases fuel with _ | fuel; · omega
      have hsub : 2 * ((xs.map canonicalEncode).flatMap (fun b => b.data.toList)).length + 1 ≤ fuel := by omega
      simp only [List.cons_append, List.append_assoc]
      rw [decodeValueAux_tag_a]
      have h1 := readNonnegUntil_app 0x3a (by decide) xs.length
        ((xs.map canonicalEncode).flatMap (fun b => b.data.toList) ++ suffix)
      have eqarr := decodeArrayAux_encode_append xs suffix fuel hnorm hsub
      simp only [h1, eqarr]
    | .record entries, suffix, fuel, hnorm, hfuel => by
      rw [canonicalEncode_record_bytes_of_pairwise hnorm.1] at hfuel ⊢
      have hdig : 1 ≤ (toString entries.length).toUTF8.data.toList.length := toString_nat_toUTF8_pos entries.length
      simp only [List.length_append, List.length_cons] at hfuel
      rcases fuel with _ | fuel; · omega
      have hsub : 2 * (encodeRecordFlat entries).length + 1 ≤ fuel := by omega
      simp only [List.cons_append, List.append_assoc]
      rw [decodeValueAux_tag_o]
      have h1 := readNonnegUntil_app 0x3a (by decide) entries.length (encodeRecordFlat entries ++ suffix)
      have eqent := decodeEntriesAux_encode_append entries none suffix fuel hnorm.2 hnorm.1 trivial hsub
      simp only [h1, eqent]

  private lemma decodeArrayAux_encode_append :
      ∀ (xs : List CanonicalValue) (suffix : List UInt8) (fuel : Nat),
        CanonicalValue.NormalizedList xs →
        2 * ((xs.map canonicalEncode).flatMap (fun b => b.data.toList)).length + 1 ≤ fuel →
        decodeArrayAux fuel xs.length ((xs.map canonicalEncode).flatMap (fun b => b.data.toList) ++ suffix) =
          .ok (xs, suffix)
    | [], suffix, fuel, _, hfuel => by
      rcases fuel with _ | fuel; · omega
      rfl
    | x :: xs, suffix, fuel, h, hfuel => by
      simp only [List.map_cons, List.flatMap_cons, List.length_append] at hfuel ⊢
      have hpos := canonicalEncode_bytes_pos x
      rcases fuel with _ | fuel; · omega
      have hf1 : 2 * (canonicalEncode x).data.toList.length ≤ fuel := by omega
      have hf2 : 2 * ((xs.map canonicalEncode).flatMap (fun b => b.data.toList)).length + 1 ≤ fuel := by omega
      rw [List.append_assoc]
      have eqv := decodeValueAux_encode_append x
        ((xs.map canonicalEncode).flatMap (fun b => b.data.toList) ++ suffix) fuel h.1 hf1
      have eqr := decodeArrayAux_encode_append xs suffix fuel h.2 hf2
      simp only [decodeArrayAux, List.length_cons, eqv, eqr]

  private lemma decodeEntriesAux_encode_append :
      ∀ (entries : List (String × CanonicalValue)) (prev : Option ByteArray)
        (suffix : List UInt8) (fuel : Nat),
        CanonicalValue.NormalizedEntries entries →
        entries.Pairwise (fun a b => compareBytes a.1.toUTF8 b.1.toUTF8 = .lt) →
        (match prev with | none => True | some pk => ∀ e ∈ entries, compareBytes pk e.1.toUTF8 = .lt) →
        2 * (encodeRecordFlat entries).length + 1 ≤ fuel →
        decodeEntriesAux fuel entries.length prev (encodeRecordFlat entries ++ suffix) = .ok (entries, suffix)
    | [], _, suffix, fuel, _, _, _, hfuel => by
      rcases fuel with _ | fuel; · omega
      rfl
    | (k, v) :: rest, prev, suffix, fuel, hne, hpw, hprev, hfuel => by
      rw [encodeRecordFlat_cons_length] at hfuel
      rcases fuel with _ | fuel; · omega
      have hf1 : 2 * (canonicalEncode v).data.toList.length ≤ fuel := by omega
      have hf2 : 2 * (encodeRecordFlat rest).length + 1 ≤ fuel := by omega
      rw [List.pairwise_cons] at hpw
      have hstr := decodeStringBody_app k ((canonicalEncode v).data.toList ++ encodeRecordFlat rest ++ suffix)
      have eqv := decodeValueAux_encode_append v (encodeRecordFlat rest ++ suffix) fuel hne.1 hf1
      have eqrest := decodeEntriesAux_encode_append rest (some k.toUTF8) suffix fuel
        hne.2 hpw.2 (fun e he => hpw.1 e he) hf2
      simp only [List.length_cons, encodeRecordFlat, List.append_assoc, List.cons_append] at eqrest hstr eqv ⊢
      rw [decodeEntriesAux_tag_s, hstr]
      cases prev with
      | none =>
        simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte, eqv, eqrest]
      | some pk =>
        have hpk : compareBytes pk k.toUTF8 = .lt := hprev (k, v) (by simp)
        have hbeq : (compareBytes pk k.toUTF8 == .lt) = true := beq_iff_eq.mpr hpk
        simp only [hbeq, Bool.not_true, Bool.false_eq_true, ↓reduceIte, eqv, eqrest]
end

/-- Decoding the canonical encoding of a normalized value returns that exact value. -/
theorem canonicalDecode_encode_normalized {v : CanonicalValue} (h : v.Normalized) :
    canonicalDecode (canonicalEncode v) = .ok v := by
  unfold canonicalDecode
  have hlen : 2 * (canonicalEncode v).data.toList.length ≤ 2 * (canonicalEncode v).size := by
    rw [byteArray_data_toList_length]
  have eqv := decodeValueAux_encode_append v [] (2 * (canonicalEncode v).size) h hlen
  simp only [List.append_nil] at eqv
  rw [eqv]

/-- Decoding the canonical encoding of any well-formed value returns its normalized form. -/
theorem canonicalDecode_encode {v : CanonicalValue} (h : v.WF) :
    canonicalDecode (canonicalEncode v) = .ok v.normalize := by
  rw [← canonicalEncode_normalize h]
  exact canonicalDecode_encode_normalized (CanonicalValue.normalize_normalized h)

/-! ### Decoder completeness (`canonicalDecode bytes = .ok v → v.Normalized ∧ canonicalEncode v = bytes`) -/

private lemma decodeEntriesAux_head_lt :
    ∀ {fuel n : Nat} {prev : Option ByteArray} {bs : List UInt8}
      {entries : List (String × CanonicalValue)} {r : List UInt8},
      decodeEntriesAux fuel n prev bs = .ok (entries, r) →
      ∀ pk, prev = some pk → ∀ e ∈ entries, compareBytes pk e.1.toUTF8 = .lt
  | 0, _, _, _, _, _, h, _, _ => by simp [decodeEntriesAux] at h
  | _ + 1, 0, _, _, entries, _, h, _, _ => by
    simp only [decodeEntriesAux, Except.ok.injEq, Prod.mk.injEq] at h
    rcases h with ⟨rfl, _⟩
    intro e he; cases he
  | fuel + 1, n + 1, prev, bs, entries, r, h, pk, hp => by
    subst hp
    cases bs with
    | nil => simp [decodeEntriesAux] at h
    | cons tag rest =>
      by_cases htag : (tag == 0x73) = true
      · simp only [decodeEntriesAux, htag, ↓reduceIte] at h
        cases h1 : decodeStringBody rest with
        | error e => simp [h1] at h
        | ok p1 =>
          rcases p1 with ⟨k, r1⟩
          simp only [h1] at h
          by_cases hord : (!(compareBytes pk k.toUTF8 == .lt)) = true
          · simp only [hord, ↓reduceIte, reduceCtorEq] at h
          · have hord' : compareBytes pk k.toUTF8 = .lt := by
              have := Bool.eq_false_iff.mpr hord
              simp only [Bool.not_eq_false', beq_iff_eq] at this
              exact this
            have hordf : (!(compareBytes pk k.toUTF8 == .lt)) = false := Bool.eq_false_iff.mpr hord
            simp only [hordf, Bool.false_eq_true, ↓reduceIte] at h
            cases h2 : decodeValueAux fuel r1 with
            | error e => simp only [h2, reduceCtorEq] at h
            | ok p2 =>
              rcases p2 with ⟨v, r2⟩
              simp only [h2] at h
              cases h3 : decodeEntriesAux fuel n (some k.toUTF8) r2 with
              | error e => simp only [h3, reduceCtorEq] at h
              | ok p3 =>
                rcases p3 with ⟨restEntries, r3⟩
                simp only [h3, Except.ok.injEq, Prod.mk.injEq] at h
                obtain ⟨rfl, _⟩ := h
                intro e he
                simp only [List.mem_cons] at he
                rcases he with rfl | he
                · exact hord'
                · have hlt := decodeEntriesAux_head_lt h3 k.toUTF8 rfl e he
                  exact compareBytes_trans _ _ _ hord' hlt
      · simp [decodeEntriesAux, Bool.eq_false_iff.mpr htag] at h

private lemma decodeEntriesAux_step_ok {fuel n : Nat} {prev : Option ByteArray} {k : String}
    {r1 : List UInt8} {entries : List (String × CanonicalValue)} {r : List UInt8}
    (h : (if (!(match prev with | none => true | some pk => compareBytes pk k.toUTF8 == .lt)) = true
          then (Except.error CanonicalErr.invalidCanonicalEncoding :
            Except CanonicalErr (List (String × CanonicalValue) × List UInt8))
          else match decodeValueAux fuel r1 with
            | .ok (v, r2) =>
              match decodeEntriesAux fuel n (some k.toUTF8) r2 with
              | .ok (restEntries, r3) => Except.ok ((k, v) :: restEntries, r3)
              | .error e => Except.error e
            | .error e => Except.error e) = Except.ok (entries, r)) :
    ∃ v r2 restEntries,
      decodeValueAux fuel r1 = .ok (v, r2) ∧
      decodeEntriesAux fuel n (some k.toUTF8) r2 = .ok (restEntries, r) ∧
      entries = (k, v) :: restEntries := by
  cases prev with
  | none =>
    simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte] at h
    cases h2 : decodeValueAux fuel r1 with
    | error e => simp only [h2, reduceCtorEq] at h
    | ok p2 =>
      rcases p2 with ⟨v, r2⟩
      simp only [h2] at h
      cases h3 : decodeEntriesAux fuel n (some k.toUTF8) r2 with
      | error e => simp only [h3, reduceCtorEq] at h
      | ok p3 =>
        rcases p3 with ⟨restEntries, r3⟩
        simp only [h3, Except.ok.injEq, Prod.mk.injEq] at h
        rcases h with ⟨h_ent, rfl⟩
        exact ⟨v, r2, restEntries, rfl, h3, h_ent.symm⟩
  | some pk =>
    by_cases hcmp : (compareBytes pk k.toUTF8 == .lt) = true
    · have hn : (!(compareBytes pk k.toUTF8 == .lt)) = false := by rw [hcmp]; rfl
      simp only [hn, Bool.false_eq_true, ↓reduceIte] at h
      cases h2 : decodeValueAux fuel r1 with
      | error e => simp only [h2, reduceCtorEq] at h
      | ok p2 =>
        rcases p2 with ⟨v, r2⟩
        simp only [h2] at h
        cases h3 : decodeEntriesAux fuel n (some k.toUTF8) r2 with
        | error e => simp only [h3, reduceCtorEq] at h
        | ok p3 =>
          rcases p3 with ⟨restEntries, r3⟩
          simp only [h3, Except.ok.injEq, Prod.mk.injEq] at h
          rcases h with ⟨h_ent, rfl⟩
          exact ⟨v, r2, restEntries, rfl, h3, h_ent.symm⟩
    · have hcmpf := Bool.eq_false_iff.mpr hcmp
      have hn : (!(compareBytes pk k.toUTF8 == .lt)) = true := by rw [hcmpf]; rfl
      simp only [hn, ↓reduceIte, reduceCtorEq] at h

private lemma decodeValueAux_ok_inv_aux : ∀ (fuel : Nat),
    (∀ (bs : List UInt8) (v : CanonicalValue) (r : List UInt8),
      decodeValueAux fuel bs = .ok (v, r) →
      v.Normalized ∧ bs = (canonicalEncode v).data.toList ++ r) ∧
    (∀ (n : Nat) (bs : List UInt8) (xs : List CanonicalValue) (r : List UInt8),
      decodeArrayAux fuel n bs = .ok (xs, r) →
      CanonicalValue.NormalizedList xs ∧ xs.length = n ∧
      bs = (xs.map canonicalEncode).flatMap (fun b => b.data.toList) ++ r) ∧
    (∀ (n : Nat) (prev : Option ByteArray) (bs : List UInt8)
      (entries : List (String × CanonicalValue)) (r : List UInt8),
      decodeEntriesAux fuel n prev bs = .ok (entries, r) →
      CanonicalValue.NormalizedEntries entries ∧
      entries.Pairwise (fun a b => compareBytes a.1.toUTF8 b.1.toUTF8 = .lt) ∧
      entries.length = n ∧
      bs = encodeRecordFlat entries ++ r)
  | 0 => ⟨fun _ _ _ h => by simp [decodeValueAux] at h,
          fun _ _ _ _ h => by simp [decodeArrayAux] at h,
          fun _ _ _ _ _ h => by simp [decodeEntriesAux] at h⟩
  | fuel + 1 => by
    have ih := decodeValueAux_ok_inv_aux fuel
    refine ⟨?_, ?_, ?_⟩
    · intro bs v r h
      cases bs with
      | nil => simp [decodeValueAux] at h
      | cons tag rest =>
        by_cases h0 : (tag == 0x6e) = true
        · simp only [decodeValueAux, h0, ↓reduceIte, Except.ok.injEq, Prod.mk.injEq] at h
          rcases h with ⟨rfl, rfl⟩
          rw [beq_iff_eq.mp h0, canonicalEncode_null_bytes]
          exact ⟨trivial, rfl⟩
        · have h0f := Bool.eq_false_iff.mpr h0
          simp only [decodeValueAux, h0f, Bool.false_eq_true, ↓reduceIte] at h
          by_cases h1 : (tag == 0x74) = true
          · simp only [h1, ↓reduceIte, Except.ok.injEq, Prod.mk.injEq] at h
            rcases h with ⟨rfl, rfl⟩
            rw [beq_iff_eq.mp h1, canonicalEncode_true_bytes]
            exact ⟨trivial, rfl⟩
          · have h1f := Bool.eq_false_iff.mpr h1
            simp only [h1f, Bool.false_eq_true, ↓reduceIte] at h
            by_cases h2 : (tag == 0x66) = true
            · simp only [h2, ↓reduceIte, Except.ok.injEq, Prod.mk.injEq] at h
              rcases h with ⟨rfl, rfl⟩
              rw [beq_iff_eq.mp h2, canonicalEncode_false_bytes]
              exact ⟨trivial, rfl⟩
            · have h2f := Bool.eq_false_iff.mpr h2
              simp only [h2f, Bool.false_eq_true, ↓reduceIte] at h
              by_cases h3 : (tag == 0x69) = true
              · simp only [h3, ↓reduceIte] at h
                cases hi1 : readCanonicalIntAux rest with
                | error e => simp [hi1] at h
                | ok p =>
                  rcases p with ⟨i, r'⟩
                  simp only [hi1, Except.ok.injEq, Prod.mk.injEq] at h
                  rcases h with ⟨rfl, rfl⟩
                  refine ⟨trivial, ?_⟩
                  rw [beq_iff_eq.mp h3, canonicalEncode_int_bytes, readCanonicalIntAux_ok_inv rest i r' hi1]
                  simp only [List.cons_append, List.append_assoc, List.nil_append]
              · have h3f := Bool.eq_false_iff.mpr h3
                simp only [h3f, Bool.false_eq_true, ↓reduceIte] at h
                by_cases h4 : (tag == 0x73) = true
                · simp only [h4, ↓reduceIte] at h
                  cases hs1 : decodeStringBody rest with
                  | error e => simp [hs1] at h
                  | ok p =>
                    rcases p with ⟨s, r'⟩
                    simp only [hs1, Except.ok.injEq, Prod.mk.injEq] at h
                    rcases h with ⟨rfl, rfl⟩
                    rw [beq_iff_eq.mp h4, canonicalEncode_string_bytes, List.cons_append]
                    exact ⟨trivial, congrArg (0x73 :: ·) (decodeStringBody_ok_inv hs1)⟩
                · have h4f := Bool.eq_false_iff.mpr h4
                  simp only [h4f, Bool.false_eq_true, ↓reduceIte] at h
                  by_cases h5 : (tag == 0x78) = true
                  · simp only [h5, ↓reduceIte] at h
                    cases hx1 : readNonnegUntil 0x3a rest with
                    | error e => simp [hx1] at h
                    | ok p1 =>
                      rcases p1 with ⟨len, r1⟩
                      simp only [hx1] at h
                      cases hx2 : takeExactAux len r1 with
                      | error e => simp [hx2] at h
                      | ok p2 =>
                        rcases p2 with ⟨taken, r2⟩
                        simp only [hx2, Except.ok.injEq, Prod.mk.injEq] at h
                        rcases h with ⟨rfl, rfl⟩
                        have hlen := readNonnegUntil_ok_inv 0x3a (by decide) rest len r1 hx1
                        obtain ⟨hr1, htlen⟩ := takeExactAux_ok_inv len r1 taken r2 hx2
                        have hba : (ByteArray.mk taken.toArray).data.toList = taken := List.toList_toArray
                        have hsz : (ByteArray.mk taken.toArray).size = len := by
                          rw [← byteArray_data_toList_length, hba, htlen]
                        rw [beq_iff_eq.mp h5, canonicalEncode_bytes_bytes, hsz, hba]
                        refine ⟨trivial, ?_⟩
                        rw [hlen, hr1]
                        simp only [List.cons_append, List.append_assoc]
                  · have h5f := Bool.eq_false_iff.mpr h5
                    simp only [h5f, Bool.false_eq_true, ↓reduceIte] at h
                    by_cases h6 : (tag == 0x61) = true
                    · simp only [h6, ↓reduceIte] at h
                      cases ha1 : readNonnegUntil 0x3a rest with
                      | error e => simp [ha1] at h
                      | ok p1 =>
                        rcases p1 with ⟨count, r1⟩
                        simp only [ha1] at h
                        cases ha2 : decodeArrayAux fuel count r1 with
                        | error e => simp [ha2] at h
                        | ok p2 =>
                          rcases p2 with ⟨xs, r2⟩
                          simp only [ha2, Except.ok.injEq, Prod.mk.injEq] at h
                          rcases h with ⟨rfl, rfl⟩
                          obtain ⟨hnorm, hlen, heqr1⟩ := ih.2.1 count r1 xs r2 ha2
                          have hr_inv := readNonnegUntil_ok_inv 0x3a (by decide) rest count r1 ha1
                          rw [beq_iff_eq.mp h6, canonicalEncode_array_bytes, hlen]
                          refine ⟨hnorm, ?_⟩
                          rw [hr_inv, heqr1]
                          simp only [List.cons_append, List.append_assoc]
                    · have h6f := Bool.eq_false_iff.mpr h6
                      simp only [h6f, Bool.false_eq_true, ↓reduceIte] at h
                      by_cases h7 : (tag == 0x6f) = true
                      · simp only [h7, ↓reduceIte] at h
                        cases ho1 : readNonnegUntil 0x3a rest with
                        | error e => simp [ho1] at h
                        | ok p1 =>
                          rcases p1 with ⟨count, r1⟩
                          simp only [ho1] at h
                          cases ho2 : decodeEntriesAux fuel count none r1 with
                          | error e => simp [ho2] at h
                          | ok p2 =>
                            rcases p2 with ⟨entries, r2⟩
                            simp only [ho2, Except.ok.injEq, Prod.mk.injEq] at h
                            rcases h with ⟨rfl, rfl⟩
                            obtain ⟨hnorm_e, hpw, hlen, heqr1⟩ := ih.2.2 count none r1 entries r2 ho2
                            have hr_inv := readNonnegUntil_ok_inv 0x3a (by decide) rest count r1 ho1
                            rw [beq_iff_eq.mp h7, canonicalEncode_record_bytes_of_pairwise hpw, hlen]
                            refine ⟨⟨hpw, hnorm_e⟩, ?_⟩
                            rw [hr_inv, heqr1]
                            simp only [List.cons_append, List.append_assoc]
                      · simp [Bool.eq_false_iff.mpr h7] at h
    · intro n bs xs r h
      cases n with
      | zero =>
        simp only [decodeArrayAux, Except.ok.injEq, Prod.mk.injEq] at h
        rcases h with ⟨rfl, rfl⟩
        exact ⟨trivial, rfl, rfl⟩
      | succ n =>
        simp only [decodeArrayAux] at h
        cases h1 : decodeValueAux fuel bs with
        | error e => simp [h1] at h
        | ok p1 =>
          rcases p1 with ⟨v, r1⟩
          simp only [h1] at h
          cases h2 : decodeArrayAux fuel n r1 with
          | error e => simp [h2] at h
          | ok p2 =>
            rcases p2 with ⟨vs, r2⟩
            simp only [h2, Except.ok.injEq, Prod.mk.injEq] at h
            rcases h with ⟨rfl, rfl⟩
            obtain ⟨hv_norm, hbs_eq⟩ := ih.1 bs v r1 h1
            obtain ⟨hvs_norm, hlen, hr1_eq⟩ := ih.2.1 n r1 vs r2 h2
            refine ⟨⟨hv_norm, hvs_norm⟩, by simp [hlen], ?_⟩
            rw [hbs_eq, hr1_eq]
            simp [List.append_assoc]
    · intro n prev bs entries r h
      cases n with
      | zero =>
        simp only [decodeEntriesAux, Except.ok.injEq, Prod.mk.injEq] at h
        rcases h with ⟨rfl, rfl⟩
        exact ⟨trivial, List.Pairwise.nil, rfl, rfl⟩
      | succ n =>
        cases bs with
        | nil => simp [decodeEntriesAux] at h
        | cons tag rest =>
          by_cases htag : (tag == 0x73) = true
          · simp only [decodeEntriesAux, htag, ↓reduceIte] at h
            cases h1 : decodeStringBody rest with
            | error e => simp only [h1, reduceCtorEq] at h
            | ok p1 =>
              rcases p1 with ⟨k, r1⟩
              simp only [h1] at h
              obtain ⟨v, r2, restEntries, h2, h3, rfl⟩ := decodeEntriesAux_step_ok h
              obtain ⟨hv_norm, hr1_eq⟩ := ih.1 r1 v r2 h2
              obtain ⟨hrest_norm, hpw_rest, hlen, hr2_eq⟩ := ih.2.2 n (some k.toUTF8) r2 restEntries r h3
              have hpw_head : ∀ e ∈ restEntries, compareBytes k.toUTF8 e.1.toUTF8 = .lt :=
                decodeEntriesAux_head_lt h3 k.toUTF8 rfl
              refine ⟨⟨hv_norm, hrest_norm⟩, List.pairwise_cons.mpr ⟨hpw_head, hpw_rest⟩, by simp [hlen], ?_⟩
              have hstr := decodeStringBody_ok_inv h1
              rw [beq_iff_eq.mp htag, encodeRecordFlat, List.cons_append]
              refine congrArg (0x73 :: ·) ?_
              rw [hstr, hr1_eq, hr2_eq]
              simp [List.append_assoc]
          · simp [decodeEntriesAux, Bool.eq_false_iff.mpr htag] at h

/-- `canonicalDecode` accepts a byte sequence iff it is the encoding of a normalized canonical value. -/
theorem canonicalDecode_ok_iff (bytes : ByteArray) (v : CanonicalValue) :
    canonicalDecode bytes = .ok v ↔ v.Normalized ∧ canonicalEncode v = bytes := by
  constructor
  · intro h
    unfold canonicalDecode at h
    cases hd : decodeValueAux (2 * bytes.size) bytes.data.toList with
    | error e => simp [hd] at h
    | ok p =>
      rcases p with ⟨v', r⟩
      cases r with
      | cons _ _ => simp [hd] at h
      | nil =>
        simp only [hd, Except.ok.injEq] at h
        subst h
        obtain ⟨hnorm, hbytes⟩ := (decodeValueAux_ok_inv_aux (2 * bytes.size)).1 bytes.data.toList v' [] hd
        refine ⟨hnorm, ?_⟩
        apply ByteArray.ext
        apply Array.toList_inj.mp
        simpa using hbytes.symm
  · rintro ⟨hnorm, rfl⟩
    exact canonicalDecode_encode_normalized hnorm

/-! ### Injectivity and Hash Collision Laws (Laws b and d) -/

/-- `canonicalEncode` is injective on normalized canonical values. -/
theorem canonicalEncode_inj_normalized {v1 v2 : CanonicalValue}
    (h1 : v1.Normalized) (h2 : v2.Normalized)
    (heq : canonicalEncode v1 = canonicalEncode v2) : v1 = v2 := by
  have hd1 := canonicalDecode_encode_normalized h1
  have hd2 := canonicalDecode_encode_normalized h2
  rw [heq, hd2] at hd1
  exact (Except.ok.inj hd1).symm

/-- `canonicalEncode` is injective on well-formed canonical values up to record entry order. -/
theorem canonicalEncode_inj {v1 v2 : CanonicalValue}
    (h1 : v1.WF) (h2 : v2.WF)
    (heq : canonicalEncode v1 = canonicalEncode v2) : v1.Equiv v2 := by
  have heq' : canonicalEncode v1.normalize = canonicalEncode v2.normalize := by
    rw [canonicalEncode_normalize h1, canonicalEncode_normalize h2, heq]
  have hnorm_eq := canonicalEncode_inj_normalized
    (CanonicalValue.normalize_normalized h1)
    (CanonicalValue.normalize_normalized h2) heq'
  have e1 := CanonicalValue.Equiv_normalize v1
  have e2 := CanonicalValue.Equiv_symm (CanonicalValue.Equiv_normalize v2)
  rw [hnorm_eq] at e1
  exact CanonicalValue.Equiv_trans e1 e2

/-- Two well-formed canonical values are equivalent up to key order iff their encodings are equal. -/
theorem canonicalEncode_eq_iff_equiv {v1 v2 : CanonicalValue} (h1 : v1.WF) (h2 : v2.WF) :
    canonicalEncode v1 = canonicalEncode v2 ↔ v1.Equiv v2 :=
  ⟨canonicalEncode_inj h1 h2, canonicalEncode_eq_of_equiv h1 h2⟩

/-- Equal well-formed values (up to record key order) produce identical `ContentHash`es. -/
theorem hashCanonical_eq_of_equiv {v1 v2 : CanonicalValue}
    (h1 : v1.WF) (h2 : v2.WF) (heq : v1.Equiv v2) :
    hashCanonical v1 = hashCanonical v2 := by
  simp only [hashCanonical, canonicalEncode_eq_of_equiv h1 h2 heq]

/-- Equal `hashCanonical` values on normalized inputs imply equal values, or else a SHA-256 collision. -/
theorem hashCanonical_inj_normalized_or_collision {v1 v2 : CanonicalValue}
    (h1 : v1.Normalized) (h2 : v2.Normalized)
    (heq : hashCanonical v1 = hashCanonical v2) :
    v1 = v2 ∨ HashCollision := by
  have hdig : sha256Hex (canonicalEncode v1) = sha256Hex (canonicalEncode v2) := by
    simpa only [hashCanonical] using congrArg ContentHash.digest heq
  have hsha : sha256 (canonicalEncode v1) = sha256 (canonicalEncode v2) :=
    (sha256Hex_eq_iff _ _).mp hdig
  by_cases he : canonicalEncode v1 = canonicalEncode v2
  · exact Or.inl (canonicalEncode_inj_normalized h1 h2 he)
  · exact Or.inr ⟨canonicalEncode v1, canonicalEncode v2, he, hsha⟩

/-- Equal `hashCanonical` values on well-formed inputs imply equivalent values up to key order, or else a SHA-256 collision. -/
theorem hashCanonical_inj_or_collision {v1 v2 : CanonicalValue}
    (h1 : v1.WF) (h2 : v2.WF)
    (heq : hashCanonical v1 = hashCanonical v2) :
    v1.Equiv v2 ∨ HashCollision := by
  have hdig : sha256Hex (canonicalEncode v1) = sha256Hex (canonicalEncode v2) := by
    simpa only [hashCanonical] using congrArg ContentHash.digest heq
  have hsha : sha256 (canonicalEncode v1) = sha256 (canonicalEncode v2) :=
    (sha256Hex_eq_iff _ _).mp hdig
  by_cases he : canonicalEncode v1 = canonicalEncode v2
  · exact Or.inl (canonicalEncode_inj h1 h2 he)
  · exact Or.inr ⟨canonicalEncode v1, canonicalEncode v2, he, hsha⟩

/-- `contentHashEquals` on two `hashCanonical` results implies equivalent values up to key order, or else a SHA-256 collision. -/
theorem contentHashEquals_hashCanonical_or_collision {v1 v2 : CanonicalValue}
    (h1 : v1.WF) (h2 : v2.WF)
    (heq : contentHashEquals (hashCanonical v1) (hashCanonical v2) = true) :
    v1.Equiv v2 ∨ HashCollision :=
  hashCanonical_inj_or_collision h1 h2 ((contentHashEquals_iff _ _).mp heq)

/-- `hashCanonicalSequenceField` succeeds iff the bounds and field invariants hold, and produces the exact hash of the combined record. -/
theorem hashCanonicalSequenceField_ok_iff
    (fields : List (String × CanonicalValue))
    (field : String)
    (length : Int)
    (values : List CanonicalValue)
    (h : ContentHash) :
    hashCanonicalSequenceField fields field length values = .ok h ↔
      0 ≤ length ∧ length ≤ maxSafeInteger ∧
      (∀ p ∈ fields, p.1 ≠ field) ∧
      values.length = length.toNat ∧
      h = hashCanonical (.record ((field, .array values) :: fields)) := by
  unfold hashCanonicalSequenceField
  by_cases h1 : (length < 0 || length > maxSafeInteger || fields.any (fun p => p.1 == field)) = true
  · simp only [h1, ↓reduceIte, reduceCtorEq, false_iff]
    intro ⟨hge, hle, hmem, _, _⟩
    simp only [Bool.or_eq_true, decide_eq_true_eq, List.any_eq_true, beq_iff_eq] at h1
    rcases h1 with (hlt | hgt) | ⟨p, hp, hpeq⟩
    · omega
    · omega
    · exact hmem p hp hpeq
  · have h1f : (length < 0 || length > maxSafeInteger || fields.any (fun p => p.1 == field)) = false :=
      Bool.eq_false_iff.mpr h1
    simp only [h1f, Bool.false_eq_true, ↓reduceIte]
    simp only [Bool.or_eq_true, decide_eq_true_eq, List.any_eq_true, beq_iff_eq, not_or, not_lt,
      not_exists, not_and] at h1
    by_cases h2 : (values.length != length.toNat) = true
    · simp only [h2, ↓reduceIte, reduceCtorEq, false_iff]
      intro ⟨_, _, _, hlen, _⟩
      simp only [bne_iff_ne, ne_eq] at h2
      exact h2 hlen
    · have h2f : (values.length != length.toNat) = false := Bool.eq_false_iff.mpr h2
      simp only [h2f, Bool.false_eq_true, ↓reduceIte, Except.ok.injEq]
      simp only [bne_iff_ne, ne_eq, not_not] at h2
      constructor
      · intro heq; exact ⟨h1.1.1, h1.1.2, h1.2, h2, heq.symm⟩
      · rintro ⟨_, _, _, _, heq⟩; exact heq.symm

/-- Two `hashCanonicalSequenceField` calls that yield equal hashes have equivalent underlying records up to key order, or else a SHA-256 collision. -/
theorem hashCanonicalSequenceField_inj_or_collision
    {fields1 fields2 : List (String × CanonicalValue)}
    {field1 field2 : String}
    {len1 len2 : Int}
    {vals1 vals2 : List CanonicalValue}
    {h1 h2 : ContentHash}
    (hwf1 : CanonicalValue.WF (.record fields1))
    (hwl1 : CanonicalValue.WFList vals1)
    (hwf2 : CanonicalValue.WF (.record fields2))
    (hwl2 : CanonicalValue.WFList vals2)
    (hok1 : hashCanonicalSequenceField fields1 field1 len1 vals1 = .ok h1)
    (hok2 : hashCanonicalSequenceField fields2 field2 len2 vals2 = .ok h2)
    (heq : h1 = h2) :
    CanonicalValue.Equiv
      (.record ((field1, .array vals1) :: fields1))
      (.record ((field2, .array vals2) :: fields2)) ∨ HashCollision := by
  obtain ⟨_, _, hno1, _, rfl⟩ := (hashCanonicalSequenceField_ok_iff _ _ _ _ _).mp hok1
  obtain ⟨_, _, hno2, _, rfl⟩ := (hashCanonicalSequenceField_ok_iff _ _ _ _ _).mp hok2
  have hwfr1 : CanonicalValue.WF (.record ((field1, .array vals1) :: fields1)) := by
    refine ⟨?_, ⟨hwl1, hwf1.2⟩⟩
    simp only [List.map_cons, List.nodup_cons, List.mem_map]
    exact ⟨fun ⟨p, hp, hpeq⟩ => hno1 p hp hpeq, hwf1.1⟩
  have hwfr2 : CanonicalValue.WF (.record ((field2, .array vals2) :: fields2)) := by
    refine ⟨?_, ⟨hwl2, hwf2.2⟩⟩
    simp only [List.map_cons, List.nodup_cons, List.mem_map]
    exact ⟨fun ⟨p, hp, hpeq⟩ => hno2 p hp hpeq, hwf2.1⟩
  exact hashCanonical_inj_or_collision hwfr1 hwfr2 heq

end NormalizationAndInverse

end Rastrata.Kernel
