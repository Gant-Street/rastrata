/-
Canonical identity, encoding, and hashing: the Lean model of `packages/kernel/src/canonical.ts`.

Includes exact Unicode NFC normalization (matching `String.prototype.normalize("NFC")`),
UTF-16 code-unit ordering (`compareCanonicalText`), canonical byte encoding (`canonicalEncode`),
an inverse byte decoder (`canonicalDecode`, not present in `canonical.ts`), and SHA-256 hashing
(`hashCanonical`, `hashCanonicalSequenceField`) with collision-aware laws (`HashCollision`).
-/
import Rastrata.Prelude
import Rastrata.Kernel.Sha256

namespace Rastrata.Kernel

/-- `CANONICALIZATION_VERSION`. -/
def canonicalizationVersion : String := "rastrata-canonical-v1"

/-- `CONTENT_HASH_ALGORITHM`. -/
def contentHashAlgorithm : String := "sha256"

/-- `IdentityError` / canonical error codes. -/
inductive CanonicalErr where
  | canonicalIdentityConflict
  | invalidCanonicalSequenceField
  | invalidCanonicalEncoding
  deriving DecidableEq, Repr, Inhabited

/-- `Identifier<Kind>`. Built only by `identifier`, as in the TypeScript. -/
structure Identifier (Kind : String) where
  value : String
  deriving DecidableEq, Repr, Inhabited

/-- `ContentHash`. -/
structure ContentHash where
  algorithm : String
  canonicalizationVersion : String
  digest : String
  deriving DecidableEq, Repr, Inhabited

/-- `contentHashEquals`. -/
def contentHashEquals (left right : ContentHash) : Bool :=
  left.algorithm == right.algorithm &&
  left.canonicalizationVersion == right.canonicalizationVersion &&
  left.digest == right.digest

/-- `CanonicalValue`. -/
inductive CanonicalValue where
  | null
  | bool (value : Bool)
  | string (value : String)
  | int (value : Int)
  | bytes (value : ByteArray)
  | array (elements : List CanonicalValue)
  | record (entries : List (String × CanonicalValue))
  deriving Inhabited

namespace CanonicalValue

mutual
  private def beq : CanonicalValue → CanonicalValue → Bool
    | .null, .null => true
    | .bool a, .bool b => a == b
    | .string a, .string b => a == b
    | .int a, .int b => a == b
    | .bytes a, .bytes b => a == b
    | .array xs, .array ys => beqList xs ys
    | .record xs, .record ys => beqEntries xs ys
    | _, _ => false

  private def beqList : List CanonicalValue → List CanonicalValue → Bool
    | [], [] => true
    | x :: xs, y :: ys => beq x y && beqList xs ys
    | _, _ => false

  private def beqEntries : List (String × CanonicalValue) → List (String × CanonicalValue) → Bool
    | [], [] => true
    | (k1, v1) :: xs, (k2, v2) :: ys => k1 == k2 && beq v1 v2 && beqEntries xs ys
    | _, _ => false
end

mutual
  private theorem beq_eq_true : ∀ (a b : CanonicalValue), beq a b = true → a = b
    | .null, .null, _ => rfl
    | .bool a, .bool b, h => by simp [beq] at h; rw [h]
    | .string a, .string b, h => by simp [beq] at h; rw [h]
    | .int a, .int b, h => by simp [beq] at h; rw [h]
    | .bytes a, .bytes b, h => by simp [beq] at h; rw [h]
    | .array xs, .array ys, h => by simp [beq] at h; rw [beqList_eq_true xs ys h]
    | .record xs, .record ys, h => by simp [beq] at h; rw [beqEntries_eq_true xs ys h]

  private theorem beqList_eq_true : ∀ (xs ys : List CanonicalValue), beqList xs ys = true → xs = ys
    | [], [], _ => rfl
    | x :: xs, y :: ys, h => by
      simp [beqList] at h
      rw [beq_eq_true x y h.1, beqList_eq_true xs ys h.2]

  private theorem beqEntries_eq_true :
      ∀ (xs ys : List (String × CanonicalValue)), beqEntries xs ys = true → xs = ys
    | [], [], _ => rfl
    | (k1, v1) :: xs, (k2, v2) :: ys, h => by
      simp [beqEntries] at h
      rw [h.1.1, beq_eq_true v1 v2 h.1.2, beqEntries_eq_true xs ys h.2]
end

mutual
  private theorem beq_refl : ∀ (a : CanonicalValue), beq a a = true
    | .null => rfl
    | .bool a => by simp [beq]
    | .string a => by simp [beq]
    | .int a => by simp [beq]
    | .bytes a => by simp [beq]
    | .array xs => beqList_refl xs
    | .record xs => beqEntries_refl xs

  private theorem beqList_refl : ∀ (xs : List CanonicalValue), beqList xs xs = true
    | [] => rfl
    | x :: xs => by simp [beqList, beq_refl x, beqList_refl xs]

  private theorem beqEntries_refl : ∀ (xs : List (String × CanonicalValue)), beqEntries xs xs = true
    | [] => rfl
    | (k, v) :: xs => by simp [beqEntries, beq_refl v, beqEntries_refl xs]
end

instance : DecidableEq CanonicalValue := fun a b =>
  if h : beq a b = true then isTrue (beq_eq_true a b h)
  else isFalse (fun heq => h (heq ▸ beq_refl a))

mutual
  private def reprAux : CanonicalValue → Nat → Std.Format
    | .null, _ => "CanonicalValue.null"
    | .bool b, _ => "CanonicalValue.bool " ++ repr b
    | .string s, _ => "CanonicalValue.string " ++ repr s
    | .int i, _ => "CanonicalValue.int " ++ repr i
    | .bytes bs, _ => "CanonicalValue.bytes " ++ repr bs.data.toList
    | .array xs, _ => "CanonicalValue.array [" ++ reprList xs ++ "]"
    | .record xs, _ => "CanonicalValue.record [" ++ reprEntries xs ++ "]"

  private def reprList : List CanonicalValue → Std.Format
    | [] => ""
    | [x] => reprAux x 0
    | x :: xs => reprAux x 0 ++ ", " ++ reprList xs

  private def reprEntries : List (String × CanonicalValue) → Std.Format
    | [] => ""
    | [(k, v)] => "(" ++ repr k ++ ", " ++ reprAux v 0 ++ ")"
    | (k, v) :: xs => "(" ++ repr k ++ ", " ++ reprAux v 0 ++ "), " ++ reprEntries xs
end

instance : Repr CanonicalValue where
  reprPrec v n := CanonicalValue.reprAux v n

end CanonicalValue

