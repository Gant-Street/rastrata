def ccc (cp : UInt32) : UInt8 :=
  if cp < 0x300 then 0
  else go 0 cccTable.size
where
  go (lo hi : Nat) : UInt8 :=
    if h : lo < hi then
      let mid := lo + (hi - lo) / 2
      let entry := cccTable[mid]!
      let start := (entry >>> 32).toUInt32
      let stop := ((entry >>> 8) &&& 0xFFFFFF).toUInt32
      if cp < start then go lo mid
      else if stop < cp then go (mid + 1) hi
      else (entry &&& 0xFF).toUInt8
    else 0
  termination_by hi - lo

def nfdChar (cp : UInt32) : List UInt32 :=
  if 0xAC00 ≤ cp && cp ≤ 0xD7A3 then
    let s := cp - 0xAC00
    let l := 0x1100 + s / 588
    let v := 0x1161 + (s % 588) / 28
    let t := s % 28
    if t == 0 then [l, v] else [l, v, 0x11A7 + t]
  else if cp < 0xC0 then
    [cp]
  else
    match lookup 0 nfdKeys.size with
    | none => [cp]
    | some entry =>
      let off := ((entry >>> 8) &&& 0xFFFFFF).toNat
      let len := (entry &&& 0xFF).toNat
      match len with
      | 1 => [nfdData[off]!]
      | 2 => [nfdData[off]!, nfdData[off + 1]!]
      | 3 => [nfdData[off]!, nfdData[off + 1]!, nfdData[off + 2]!]
      | 4 => [nfdData[off]!, nfdData[off + 1]!, nfdData[off + 2]!, nfdData[off + 3]!]
      | _ => [cp]
where
  lookup (lo hi : Nat) : Option UInt64 :=
    if h : lo < hi then
      let mid := lo + (hi - lo) / 2
      let entry := nfdKeys[mid]!
      let k := (entry >>> 32).toUInt32
      if cp < k then lookup lo mid
      else if k < cp then lookup (mid + 1) hi
      else some entry
    else none
  termination_by hi - lo

def composePair (a b : UInt32) : Option UInt32 :=
  if 0x1100 ≤ a && a ≤ 0x1112 && 0x1161 ≤ b && b ≤ 0x1175 then
    some (0xAC00 + ((a - 0x1100) * 21 + (b - 0x1161)) * 28)
  else if 0xAC00 ≤ a && a ≤ 0xD7A3 && (a - 0xAC00) % 28 == 0 && 0x11A8 ≤ b && b ≤ 0x11C2 then
    some (a + (b - 0x11A7))
  else if b < 0x300 then
    none
  else
    let target : UInt64 := (a.toUInt64 <<< 21) ||| b.toUInt64
    match lookup target 0 composeTable.size with
    | none => none
    | some entry => some (entry &&& 0x1FFFFF).toUInt32
where
  lookup (target : UInt64) (lo hi : Nat) : Option UInt64 :=
    if h : lo < hi then
      let mid := lo + (hi - lo) / 2
      let entry := composeTable[mid]!
      let k := entry >>> 21
      if target < k then lookup target lo mid
      else if k < target then lookup target (mid + 1) hi
      else some entry
    else none
  termination_by hi - lo

private def insertByCCC (x : UInt32) : List UInt32 → List UInt32
  | [] => [x]
  | y :: ys => if ccc x < ccc y then x :: y :: ys else y :: insertByCCC x ys

private def reorderLoop (run : List UInt32) (acc : List UInt32) : List UInt32 → List UInt32
  | [] => acc ++ run
  | c :: cs =>
    if ccc c == 0 then reorderLoop [] (acc ++ run ++ [c]) cs
    else reorderLoop (insertByCCC c run) acc cs

def canonicalOrder (cps : List UInt32) : List UInt32 :=
  reorderLoop [] [] cps

private def composeLoop (out : List UInt32) (starter : Option UInt32)
    (marks : List UInt32) (lastCCC : UInt8) : List UInt32 → List UInt32
  | [] =>
    match starter with
    | none => out
    | some s => out ++ [s] ++ marks
  | ch :: rest =>
    let chCCC := ccc ch
    let notBlocked := marks.isEmpty || lastCCC < chCCC
    let composed :=
      match starter with
      | some s => if notBlocked then composePair s ch else none
      | none => none
    match composed with
    | some c => composeLoop out (some c) marks lastCCC rest
    | none =>
      if chCCC == 0 then
        let out' := match starter with | none => out | some s => out ++ [s] ++ marks
        composeLoop out' (some ch) [] 0 rest
      else
        match starter with
        | none => composeLoop (out ++ [ch]) none [] 0 rest
        | some _ => composeLoop out starter (marks ++ [ch]) chCCC rest

def normalizeNFCList (cps : List UInt32) : List UInt32 :=
  let decomposed := cps.flatMap nfdChar
  let ordered := canonicalOrder decomposed
  composeLoop [] none [] 0 ordered

end UnicodeNFC

/-- Unicode NFC normalization matching JavaScript `String.prototype.normalize("NFC")`. -/
def toNFC (s : String) : String :=
  let cps := s.toList.map (fun c => UInt32.ofNat c.toNat)
  let nfc := UnicodeNFC.normalizeNFCList cps
  String.ofList (nfc.map (fun cp => Char.ofNat cp.toNat))

/-- Whether a string is already in Unicode NFC form. -/
def isNFC (s : String) : Bool :=
  toNFC s == s

/-! ## Identifier validation (`identifier`) -/

/-- ECMAScript `WhiteSpace` and `LineTerminator` characters stripped by `String.prototype.trim()`. -/
def isJsWhitespace (c : Char) : Bool :=
  let n := c.toNat
  (0x09 ≤ n && n ≤ 0x0D) || n == 0x20 || n == 0xA0 || n == 0x1680 ||
  (0x2000 ≤ n && n ≤ 0x200A) || n == 0x2028 || n == 0x2029 ||
  n == 0x202F || n == 0x205F || n == 0x3000 || n == 0xFEFF

private def dropLeadingJsWs : List Char → List Char
  | [] => []
  | c :: cs => if isJsWhitespace c then dropLeadingJsWs cs else c :: cs

/-- JavaScript `String.prototype.trim()`. -/
def jsTrim (s : String) : String :=
  String.ofList (dropLeadingJsWs (dropLeadingJsWs s.toList).reverse).reverse

/-- Unicode General Category `Cc` (`/\p{Cc}/u`). -/
def isControlChar (c : Char) : Bool :=
  decide (c.toNat ≤ 0x1F ∨ (0x7F ≤ c.toNat ∧ c.toNat ≤ 0x9F))

/-- Valid identifier predicate matching `identifier` in `canonical.ts`. -/
def isValidIdentifier (value : String) : Bool :=
  !value.isEmpty && jsTrim value == value && isNFC value && !value.toList.any isControlChar

/-- `identifier<Kind>`. -/
def identifier (Kind : String) (value : String) : Except CanonicalErr (Identifier Kind) :=
  if value.isEmpty || jsTrim value != value then
    .error .canonicalIdentityConflict
  else if !isNFC value then
    .error .canonicalIdentityConflict
  else if value.toList.any isControlChar then
    .error .canonicalIdentityConflict
  else
    .ok ⟨value⟩

/-- What every constructed `Identifier` satisfies. -/
structure Identifier.WF {Kind : String} (id : Identifier Kind) : Prop where
  nonempty : id.value ≠ ""
  no_boundary_whitespace : jsTrim id.value = id.value
  nfc : isNFC id.value = true
  no_control_chars : ∀ c ∈ id.value.toList, isControlChar c = false

/-- What every `hashCanonical` output satisfies. -/
structure ContentHash.WF (h : ContentHash) : Prop where
  algorithm_eq : h.algorithm = Rastrata.Kernel.contentHashAlgorithm
  version_eq : h.canonicalizationVersion = Rastrata.Kernel.canonicalizationVersion
  digest_length : h.digest.length = 64
  digest_hex : ∀ c ∈ h.digest.toList, isLowerHexChar c = true

/-! ## Text comparison and byte comparison -/

/-- UTF-16 code units of a single Unicode scalar value. -/
def charToUTF16 (c : Char) : List UInt16 :=
  let n := c.toNat
  if n < 0x10000 then
    [UInt16.ofNat n]
  else
    let m := n - 0x10000
    [UInt16.ofNat (0xD800 + (m >>> 10)), UInt16.ofNat (0xDC00 + (m &&& 0x3FF))]

/-- UTF-16 code-unit sequence of a Lean `String`. -/
def stringToUTF16 (s : String) : List UInt16 :=
  s.toList.flatMap charToUTF16

/-- `compareCanonicalText`: deterministic UTF-16 code-unit ordering (`-1`, `0`, `1` as `Ordering`). -/
def compareCanonicalText (left right : String) : Ordering :=
  compare (stringToUTF16 left) (stringToUTF16 right)

/-- `compareBytes`: unsigned lexicographical comparison on `ByteArray`. -/
def compareBytes (left right : ByteArray) : Ordering :=
  let common := min left.size right.size
  go 0 common
where
  go (i common : Nat) : Ordering :=
    if h : i < common then
      let l := left.get! i
      let r := right.get! i
      if l < r then .lt
      else if r < l then .gt
      else go (i + 1) common
    else
      compare left.size right.size
  termination_by common - i

/-! ## Canonical encoding and hashing -/

/-- Sort canonical record entries by UTF-8 key bytes stably (`entries.sort(compareCanonicalEntries)`). -/
def sortCanonicalEntries (entries : List (String × CanonicalValue)) :
    List (String × CanonicalValue) :=
  entries.mergeSort (fun a b => compareBytes a.1.toUTF8 b.1.toUTF8 != .gt)

private def writeLengthBytes (len : Nat) : ByteArray :=
  (toString len ++ ":").toUTF8

private def encodeArrayAux (xs : List ByteArray) : ByteArray :=
  let header := "a".toUTF8 ++ writeLengthBytes xs.length
  xs.foldl (· ++ ·) header

private def encodeRecordAux (encodedEntries : List (ByteArray × ByteArray)) : ByteArray :=
  let sorted := encodedEntries.mergeSort (fun a b => compareBytes a.1 b.1 != .gt)
  let header := "o".toUTF8 ++ writeLengthBytes sorted.length
  sorted.foldl (fun acc (kb, vb) =>
    acc ++ "s".toUTF8 ++ writeLengthBytes kb.size ++ kb ++ vb) header

mutual
  /-- `canonicalEncode`. -/
  def canonicalEncode : CanonicalValue → ByteArray
    | .null => "n".toUTF8
    | .bool true => "t".toUTF8
    | .bool false => "f".toUTF8
    | .int v => ("i" ++ toString v ++ ";").toUTF8
    | .string s =>
      let b := s.toUTF8
      "s".toUTF8 ++ writeLengthBytes b.size ++ b
    | .bytes b =>
      "x".toUTF8 ++ writeLengthBytes b.size ++ b
    | .array xs => encodeArrayAux (encodeList xs)
    | .record entries => encodeRecordAux (encodeEntryList entries)

  private def encodeList : List CanonicalValue → List ByteArray
    | [] => []
    | x :: xs => canonicalEncode x :: encodeList xs

  private def encodeEntryList : List (String × CanonicalValue) → List (ByteArray × ByteArray)
    | [] => []
    | (k, v) :: rest => (k.toUTF8, canonicalEncode v) :: encodeEntryList rest
end

/-- `hashCanonical`. -/
def hashCanonical (value : CanonicalValue) : ContentHash :=
  { algorithm := contentHashAlgorithm
    canonicalizationVersion := canonicalizationVersion
    digest := sha256Hex (canonicalEncode value) }

/-- `Number.MAX_SAFE_INTEGER` (`2^53 - 1`), the upper bound checked by `hashCanonicalSequenceField`. -/
def maxSafeInteger : Int := 9007199254740991

/-- `hashCanonicalSequenceField`. -/
def hashCanonicalSequenceField
    (fields : List (String × CanonicalValue))
    (field : String)
    (length : Int)
    (values : List CanonicalValue) : Except CanonicalErr ContentHash :=
  if length < 0 || length > maxSafeInteger || fields.any (fun p => p.1 == field) then
    .error .invalidCanonicalSequenceField
  else if values.length != length.toNat then
    .error .invalidCanonicalSequenceField
  else
    .ok (hashCanonical (.record ((field, .array values) :: fields)))

