{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rastrata-ledger-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "DEPLOYMENT_KIND": "synthetic-development-only",
    "DEV_EXPIRES_AT": "0"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOOKS", "class_name": "SyntheticBook" },
      { "name": "NATIVE_BOOKS", "class_name": "SyntheticNativeBook" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyntheticBook"] },
    { "tag": "v2-native-smoke", "new_sqlite_classes": ["SyntheticNativeBook"] }
  ]
}
