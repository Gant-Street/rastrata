{
  "name": "@gantstreet/rastrata-plugin-sdk",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "MIT-licensed SDK, runner, and 5-invariant test harness for building Rastrata ingestion plugins",
  "homepage": "https://rastrata.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gant-Street/rastrata.git",
    "directory": "packages/plugin-sdk"
  },
  "bugs": {
    "url": "https://github.com/Gant-Street/rastrata/issues"
  },
  "keywords": [
    "rastrata",
    "accounting",
    "bookkeeping",
    "ledger",
    "plugin",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./runner": {
        "types": "./dist/runner.d.ts",
        "default": "./dist/runner.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./runner": "./src/runner.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare:publish": "bun scripts/prepare-publish.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test ./test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
